@startuml Activity_Diagram_1_Authentication
title Activity Diagram 1 - Autentikasi dan Otorisasi Pengguna

|User|
start
:Buka Halaman Login;
:Input Email & Password;
:Submit Form;

|Laravel Auth|
:Validasi Credentials;
:Query Database;

if (Login Berhasil?) then (Ya)
  :Create Session;
  :Load User Roles
  (Spatie Permission);
  
  |User|
  :Redirect ke Dashboard;
  :Akses Menu Sesuai Role;
  
  note right
    Admin → Full Access
    Pemerintah → Prediksi
    Akademisi → View Only
  end note
  
else (Tidak)
  |User|
  :Tampilkan Error;
endif

stop

@enduml
