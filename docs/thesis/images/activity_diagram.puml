@startuml Activity_Diagram_Prediksi_NBM
title Activity Diagram - Sistem Prediksi Konsumsi Kalori NBM

|User (Pemerintah)|
start
:Login ke Sistem;
:Pilih Menu\nPrediksi NBM;

|System|
:Tampilkan Form\nParameter Prediksi;

|User (Pemerintah)|
:Input Parameter:\n- Kelompok Komoditas\n- Jenis Komoditi\n- Jumlah Bulan Prediksi;
:Submit Form;

|Laravel Controller|
:Validasi Input\nParameter;

if (Validasi Berhasil?) then (Ya)
  :Query Data Historis\n6 Bulan Terakhir\ndari MySQL;
  
  if (Data Cukup?) then (Ya)
    :Format Data\nke JSON Payload;
    :Kirim HTTP POST\nke FastAPI\n/predict endpoint;
    
    |FastAPI ML Service|
    :Terima Request\nPrediction;
    :Validasi Payload\n(Pydantic Model);
    
    if (Payload Valid?) then (Ya)
      :Load Model LSTM\ndari Memory;
      :Preprocessing Data:\n- MinMaxScaler\n- Create Sequences (6 months);
      :LSTM Inference\n(Forward Pass);
      :HuberRegressor\nPrediction;
      :Ensemble Weighting\n(70% LSTM + 30% Huber);
      :Hitung Confidence\nInterval (±15%);
      :Format Response\nJSON;
      
      |Laravel Controller|
      :Terima Response\nJSON dari FastAPI;
      :Parse Prediction\nResults;
      :Simpan ke\nprediction_histories\ntable;
      
      |Livewire Component|
      :Render Hasil:\n- Tabel Prediksi\n- Grafik Tren\n- Confidence Interval\n- Model Info;
      
      |User (Pemerintah)|
      :Review Hasil\nPrediksi;
      
      if (Perlu Export?) then (Ya)
        :Klik Export\nto Excel;
        
        |Laravel Controller|
        :Set Session Data;
        :Redirect ke\nExport Route;
        :Generate Excel\n(Maatwebsite);
        :Stream File\n.xlsx;
        
        |User (Pemerintah)|
        :Download File\nExcel;
      else (Tidak)
      endif
      
    else (Tidak Valid)
      |FastAPI ML Service|
      :Return Error 422\n(Validation Error);
      
      |Laravel Controller|
      :Log Error;
      :Tampilkan Pesan\nError ke User;
    endif
    
  else (Data Tidak Cukup)
    |Laravel Controller|
    :Tampilkan Warning:\n"Data historis tidak\nmencukupi untuk prediksi";
  endif
  
else (Tidak)
  |Laravel Controller|
  :Tampilkan Error\nValidasi Form;
endif

|User (Pemerintah)|
:Selesai;
stop

@enduml
