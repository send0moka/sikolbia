@startuml Sequence_Diagram_Prediksi_NBM
title Sequence Diagram - Interaksi Prediksi Konsumsi Kalori NBM

actor "User\n(Pemerintah)" as User
participant "Browser\n(Livewire)" as Browser
participant "Laravel\nController" as Laravel
database "MySQL\nDatabase" as MySQL
participant "FastAPI\nML Service" as FastAPI
participant "LSTM\nModel" as LSTM
participant "HuberRegressor\nModel" as Huber
database "Redis\nCache" as Redis

User -> Browser: Akses halaman prediksi
Browser -> Laravel: GET /admin/konsumsi-pangan/prediksi-nbm
Laravel --> Browser: Return view form prediksi

User -> Browser: Input parameter:\n- Kelompok: "01"\n- Komoditi: "0101" (Gabah)\n- Bulan: 6

Browser -> Laravel: POST /admin/konsumsi-pangan/prediksi-nbm/run
activate Laravel

Laravel -> Laravel: Validasi input\n(Form Request)

alt Validasi Gagal
    Laravel --> Browser: Error 422 (Validation Failed)
    Browser --> User: Tampilkan error validasi
else Validasi Berhasil
    
    Laravel -> MySQL: SELECT * FROM transaksi_nbms\nWHERE kode_kelompok = '01'\nAND kode_komoditi = '0101'\nORDER BY tahun DESC, bulan DESC\nLIMIT 6
    activate MySQL
    MySQL --> Laravel: Return 6 records historis
    deactivate MySQL
    
    alt Data Historis < 6 bulan
        Laravel --> Browser: Warning: Data tidak mencukupi
        Browser --> User: Tampilkan peringatan
    else Data Historis Cukup
        
        Laravel -> Laravel: Format payload JSON:\n{\n  "data": [\n    {tahun, bulan, komoditi,\n     kalori_hari},\n    ...\n  ]\n}
        
        Laravel -> FastAPI: POST /predict\nContent-Type: application/json\nTimeout: 30s
        activate FastAPI
        
        FastAPI -> FastAPI: Validasi payload\n(Pydantic PredictionRequest)
        
        alt Payload Invalid
            FastAPI --> Laravel: 422 Unprocessable Entity\n{"detail": "Validation error"}
            Laravel --> Browser: Error: Invalid data format
            Browser --> User: Tampilkan error
        else Payload Valid
            
            FastAPI -> FastAPI: Preprocessing:\n- Extract features\n- MinMaxScaler normalization\n- Create sequences (6 months)
            
            FastAPI -> LSTM: Predict(X_sequences)
            activate LSTM
            LSTM -> LSTM: Forward pass:\n- Forget gate\n- Input gate\n- Cell state update\n- Output gate
            LSTM --> FastAPI: LSTM predictions\n[y1, y2, ..., y6]
            deactivate LSTM
            
            FastAPI -> Huber: Predict(X_features)
            activate Huber
            Huber -> Huber: Huber loss regression\n(δ = 1.35)
            Huber --> FastAPI: Huber predictions\n[h1, h2, ..., h6]
            deactivate Huber
            
            FastAPI -> FastAPI: Ensemble:\nfinal = 0.7 * LSTM + 0.3 * Huber
            
            FastAPI -> FastAPI: Inverse transform:\nscaler_y.inverse_transform()
            
            FastAPI -> FastAPI: Hitung confidence interval:\nlower = prediction * 0.85\nupper = prediction * 1.15
            
            FastAPI -> FastAPI: Format response:\n{\n  "success": true,\n  "prediction": [...],\n  "confidence_interval": {...},\n  "model_info": {...}\n}
            
            FastAPI --> Laravel: 200 OK\nJSON response
            deactivate FastAPI
            
            Laravel -> Laravel: Parse JSON response
            
            Laravel -> MySQL: INSERT INTO prediction_histories\n(user_id, kelompok, komoditi,\n prediction_data, historical_data,\n confidence_intervals)
            activate MySQL
            MySQL --> Laravel: Insert success (ID: 1234)
            deactivate MySQL
            
            Laravel -> Redis: CACHE prediction result\nTTL: 24 hours\nKey: "pred_{kelompok}_{komoditi}_{date}"
            activate Redis
            Redis --> Laravel: Cache stored
            deactivate Redis
            
            Laravel --> Browser: JSON response:\n{\n  "status": "success",\n  "predictions": [...],\n  "chart_data": {...},\n  "history_id": 1234\n}
            
            Browser -> Browser: Render hasil:\n- Update tabel prediksi\n- Render chart (Chart.js)\n- Tampilkan CI bars\n- Display model info
            
            Browser --> User: Tampilkan hasil prediksi\ndengan visualisasi
            
            User -> Browser: Klik "Export to Excel"
            
            Browser -> Laravel: GET /admin/konsumsi-pangan/export-prediksi\n?history_id=1234
            activate Laravel
            
            Laravel -> Laravel: Set session:\nSession::put('export_id', 1234)
            
            Laravel -> Laravel: Redirect ke export route
            
            Laravel -> MySQL: SELECT * FROM prediction_histories\nWHERE id = 1234
            activate MySQL
            MySQL --> Laravel: Return prediction record
            deactivate MySQL
            
            Laravel -> Laravel: Generate Excel:\n- Maatwebsite\\Excel\\Excel\n- PredictionExport class\n- Format cells, headers
            
            Laravel --> Browser: Stream .xlsx file\nContent-Type: application/vnd.ms-excel\nContent-Disposition: attachment
            deactivate Laravel
            
            Browser --> User: Download file Excel\n"Prediksi_Gabah_20251218.xlsx"
            
        end
        
    end
    
end

deactivate Laravel

@enduml
