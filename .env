ML_API_URL=http://fastapi-ml:8000
NBM_API_TIMEOUT=30
NBM_API_RETRIES=3
NBM_API_RETRY_DELAY=1000
NBM_LOGGING_ENABLED=true
NBM_LOG_PREDICTIONS=true

