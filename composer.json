{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sikolbia/sikolbia",
    "type": "project",
    "description": "SIKOLBIA (Sistem Informasi Konsumsi + Lahan + Iklim + Benih + Alamat) is a Laravel application that provides a comprehensive platform for managing and analyzing food consumption, land, climate, seeds, and address data.",
    "keywords": [
        "laravel",
        "framework",
        "sikolbia",
        "konsumsi-pangan",
        "lahan",
        "iklim",
        "benih",
        "alamat"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "google-gemini-php/laravel": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "livewire/flux": "^2.1.1",
        "livewire/livewire": "^3.6",
        "livewire/volt": "^1.7.0",
        "maatwebsite/excel": "^3.1",
        "openai-php/laravel": "^0.17.1",
        "phpoffice/phpspreadsheet": "^1.30",
        "spatie/laravel-permission": "^6.21"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "pest": [
            "@php -r \"file_exists('database/testing.sqlite') || touch('database/testing.sqlite');\"",
            "@php artisan optimize:clear --env=testing --ansi",
            "@php artisan migrate:fresh --env=testing --quiet --ansi",
            "@php artisan db:seed --env=testing --class=RolePermissionSeeder --ansi",
            "@php artisan view:clear --env=testing --ansi",
            "./vendor/bin/pest --colors=always"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
