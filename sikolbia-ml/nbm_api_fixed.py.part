            # Calculate confidence interval (wider for future steps)
            uncertainty_factor = 1 + (step * 0.1)  # Increase uncertainty over time
            std_dev = base_std_dev * uncertainty_factor
            
            lower_bound = float(pred - 1.96 * std_dev)
            upper_bound = float(pred + 1.96 * std_dev)
            margin = (upper_bound - lower_bound) / 2
            margin_percent = (margin / pred * 100) if pred != 0 else 0
            
            ci = {
                "lower_bound": lower_bound,
                "upper_bound": upper_bound,
                "margin_percent": float(margin_percent)
            }
            confidence_intervals.append(ci)

            logger.info(f"Step {step+1}: Prediction={pred:.2f}, CI=[{lower_bound:.2f}, {upper_bound:.2f}], Margin={margin_percent:.1f}%")
            
            # Update sequence for next prediction
