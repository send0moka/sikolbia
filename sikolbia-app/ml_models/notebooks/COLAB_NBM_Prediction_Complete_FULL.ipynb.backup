    "df_test = df_test.iloc[SEQUENCE_WINDOW:].reset_index(drop=True)  # Align with LSTM sequences\n",
    "\n",
    "# Add predictions\n",
    "df_test['pred_huber'] = y_test_pred_huber[SEQUENCE_WINDOW:]\n",
    "df_test['pred_ensemble'] = y_test_pred_ensemble\n",
    "df_test['actual'] = y_test_aligned\n",
    "\n",
    "# Calculate per-commodity MAPE for major commodities\n",
    "major_commodities = ['Beras', 'Jagung', 'Gula Pasir', 'Kedelai', 'Ubi Kayu', 'Kentang']\n",
    "\n",
    "print(\"\\n📊 Major Commodities Performance:\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for commodity in major_commodities:\n",
    "    if commodity not in df_test['nama_komoditi'].values:\n",
    "        continue\n",
    "\n",
    "    mask = df_test['nama_komoditi'] == commodity\n",
    "    if mask.sum() == 0:\n",
    "        continue\n",
    "\n",
    "    actual = df_test.loc[mask, 'actual'].values\n",
    "    pred_huber = df_test.loc[mask, 'pred_huber'].values\n",
    "    pred_ensemble = df_test.loc[mask, 'pred_ensemble'].values\n",
    "\n",
    "    # Calculate MAPE\n",
    "    mape_huber = np.mean(np.abs((actual - pred_huber) / actual)) * 100\n",
    "    mape_ensemble = np.mean(np.abs((actual - pred_ensemble) / actual)) * 100\n",
    "\n",
    "    avg_actual = actual.mean()\n",
    "    samples = len(actual)\n",
    "\n",
    "    print(f\"\\n{commodity}:\")\n",
    "    print(f\"  Samples: {samples:,}\")\n",
    "    print(f\"  Avg actual: {avg_actual:.2f} kkal/kapita/hari\")\n",
    "    print(f\"  Huber MAPE: {mape_huber:.2f}%\")\n",
