    "print(f\"\\n📊 Expected data reduction:\")\n",
    "train_nuclear = np.sum(y_train >= NUCLEAR_THRESHOLD)\n",
    "test_nuclear = np.sum(y_test >= NUCLEAR_THRESHOLD)\n",
    "print(f\"  Train: {train_nuclear:,} samples ({train_nuclear/len(y_train)*100:.1f}%)\")\n",
    "print(f\"  Test:  {test_nuclear:,} samples ({test_nuclear/len(y_test)*100:.1f}%)\")\n",
    "\n",
    "# Filter\n",
    "mask_train_nuclear = y_train >= NUCLEAR_THRESHOLD\n",
    "X_train_nuclear = X_train_scaled[mask_train_nuclear]\n",
    "y_train_nuclear = y_train[mask_train_nuclear]\n",
    "\n",
    "mask_val_nuclear = y_val >= NUCLEAR_THRESHOLD\n",
    "X_val_nuclear = X_val_scaled[mask_val_nuclear]\n",
    "y_val_nuclear = y_val[mask_val_nuclear]\n",
    "\n",
    "mask_test_nuclear = y_test >= NUCLEAR_THRESHOLD\n",
    "X_test_nuclear = X_test_scaled[mask_test_nuclear]\n",
    "y_test_nuclear = y_test[mask_test_nuclear]\n",
    "\n",
    "print(\"\\n✅ NUCLEAR datasets created\")\n",
    "\n",
    "# NUCLEAR XGBoost\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"☢️ NUCLEAR XGBOOST - 3000 TREES + MAX DEPTH 25\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "import xgboost as xgb\n",
    "from datetime import datetime\n",
    "\n",
    "model_xgb_nuclear = xgb.XGBRegressor(\n",
    "    n_estimators=3000,\n",
    "    max_depth=25,\n",
    "    learning_rate=0.003,  # Very slow\n",
    "    min_child_weight=0.1,\n",
    "    subsample=0.95,\n",
    "    colsample_bytree=0.95,\n",
    "    gamma=0.001,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    verbosity=0\n",
    ")\n",
    "\n",
    "print(f\"\\n🚀 Training... (30-40 minutes)\")\n",
    "print(f\"   Start: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "start = datetime.now()\n",
    "\n",
    "model_xgb_nuclear.fit(\n",
    "    X_train_nuclear,\n",
    "    y_train_nuclear,\n",
    "    eval_set=[(X_val_nuclear, y_val_nuclear)],\n",
    "    verbose=False\n",
    ")\n",
    "\n",
    "duration = (datetime.now() - start).total_seconds()\n",
    "print(f\"✅ Done in {duration/60:.1f} minutes\")\n",
    "\n",
    "# Predict & evaluate\n",
    "y_pred_nuclear = model_xgb_nuclear.predict(X_test_nuclear)\n",
    "mape_nuclear = np.mean(np.abs((y_test_nuclear - y_pred_nuclear) / y_test_nuclear)) * 100\n",
