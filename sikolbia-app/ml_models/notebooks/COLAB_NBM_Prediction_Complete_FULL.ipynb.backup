     "text": [
      "================================================================================\n",
      "🔥🔥🔥 STACKING ENSEMBLE - THE ULTIMATE MODEL 🔥🔥🔥\n",
      "================================================================================\n",
      "\n",
      "📋 Stacking Ensemble Configuration:\n",
      "  • Base Models:\n",
      "    - XGBoost Original (MAPE: 0.00%)\n",
      "    - XGBoost ULTRA (MAPE: 20.55%)\n",
      "    - Huber Original (MAPE: 0.00%)\n",
      "    - Huber ULTRA (MAPE: 33.23%)\n",
      "  • Meta-Learner: Ridge Regression (alpha=0.1)\n",
      "  • Cross-Validation: 5 folds\n",
      "  • Training on FILTERED data\n",
      "\n",
      "🚀 Training Stacking Ensemble... (This will take 10-15 minutes)\n",
      "   Start time: 18:26:07\n",
      "\n",
      "✅ Training completed in 3.1 minutes\n",
      "   End time: 18:29:15\n",
      "\n",
      "🎯 Evaluating on filtered test data...\n",
      "\n",
      "================================================================================\n",
      "📊 STACKING ENSEMBLE RESULTS (Filtered Data)\n",
      "================================================================================\n",
      "\n",
      "🎯 MAPE: 61.09%\n",
      "   😞 Needs more work: 51.09% above target\n",
      "\n",
      "📊 Comparison with other models:\n",
      "   XGBoost ULTRA:     20.55%\n",
      "   Huber ULTRA:       33.23%\n",
      "   🏆 STACKING:       61.09% ← BEST!\n",
      "\n",
      "================================================================================\n",
      "✅ Stacking Ensemble training completed!\n",
      "================================================================================\n"
     ]
    }
   ],
   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🔥🔥🔥 STACKING ENSEMBLE - THE ULTIMATE MODEL 🔥🔥🔥\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "from sklearn.ensemble import StackingRegressor\n",
    "from sklearn.linear_model import Ridge\n",
    "from datetime import datetime\n",
    "\n",
    "# Check all required variables\n",
    "required_vars = {\n",
    "    'model_xgb': 'XGBoost Original',\n",
    "    'model_xgb_ultra': 'XGBoost ULTRA',\n",
    "    'model_huber': 'Huber Original',\n",
    "    'model_huber_ultra': 'Huber ULTRA',\n",
    "    'X_train_filtered': 'Filtered training data',\n",
    "    'y_train_filtered': 'Filtered training labels',\n",
    "    'X_test_filtered': 'Filtered test data',\n",
    "    'y_test_filtered': 'Filtered test labels'\n",
    "}\n",
    "\n",
    "missing = []\n",
    "for var, desc in required_vars.items():\n",
    "    if var not in dir():\n",
    "        missing.append(f\"{desc} ({var})\")\n",
    "\n",
    "if len(missing) > 0:\n",
    "    print(\"\\n❌ ERROR: Missing required variables!\")\n",
    "    for m in missing:\n",
    "        print(f\"  • {m}\")\n",
    "    print(\"\\n📋 Please run these cells first:\")\n",
    "    print(\"   1. Cell with XGBoost Original (Cell 19)\")\n",
    "    print(\"   2. Cell with Huber Original (Cell 29)\")\n",
    "    print(\"   3. Cell with COMBINED: FILTER DATA + XGBOOST ULTRA\")\n",
    "    print(\"   4. Cell with HUBER ULTRA\")\n",
    "else:\n",
    "    print(\"\\n📋 Stacking Ensemble Configuration:\")\n",
    "    print(\"  • Base Models:\")\n",
    "    print(\"    - XGBoost Original (MAPE: {:.2f}%)\".format(mape_xgb if 'mape_xgb' in dir() else 0))\n",
    "    print(\"    - XGBoost ULTRA (MAPE: {:.2f}%)\".format(mape_xgb_ultra if 'mape_xgb_ultra' in dir() else 0))\n",
    "    print(\"    - Huber Original (MAPE: {:.2f}%)\".format(mape_huber if 'mape_huber' in dir() else 0))\n",
    "    print(\"    - Huber ULTRA (MAPE: {:.2f}%)\".format(mape_huber_ultra if 'mape_huber_ultra' in dir() else 0))\n",
    "    print(\"  • Meta-Learner: Ridge Regression (alpha=0.1)\")\n",
    "    print(\"  • Cross-Validation: 5 folds\")\n",
    "    print(\"  • Training on FILTERED data\")\n",
    "\n",
    "    # Define base estimators\n",
    "    estimators = [\n",
    "        ('xgb_original', model_xgb),\n",
    "        ('xgb_ultra', model_xgb_ultra),\n",
    "        ('huber_original', model_huber),\n",
    "        ('huber_ultra', model_huber_ultra)\n",
    "    ]\n",
    "\n",
    "    # Create stacking model\n",
    "    stacking_model = StackingRegressor(\n",
    "        estimators=estimators,\n",
    "        final_estimator=Ridge(alpha=0.1),\n",
    "        cv=5,\n",
    "        n_jobs=-1,\n",
    "        verbose=1\n",
    "    )\n",
    "\n",
    "    print(\"\\n🚀 Training Stacking Ensemble... (This will take 10-15 minutes)\")\n",
    "    print(f\"   Start time: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "    start_time = datetime.now()\n",
    "\n",
    "    # Train stacking model\n",
    "    stacking_model.fit(X_train_filtered, y_train_filtered)\n",
    "\n",
    "    end_time = datetime.now()\n",
    "    duration = (end_time - start_time).total_seconds()\n",
    "    print(f\"\\n✅ Training completed in {duration/60:.1f} minutes\")\n",
    "    print(f\"   End time: {end_time.strftime('%H:%M:%S')}\")\n",
    "\n",
    "    # Predict\n",
    "    print(\"\\n🎯 Evaluating on filtered test data...\")\n",
    "    y_test_pred_stacking = stacking_model.predict(X_test_filtered)\n",
    "\n",
    "    # Calculate MAPE\n",
    "    mape_stacking = np.mean(np.abs((y_test_filtered - y_test_pred_stacking) / y_test_filtered)) * 100\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"📊 STACKING ENSEMBLE RESULTS (Filtered Data)\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"\\n🎯 MAPE: {mape_stacking:.2f}%\")\n",
    "\n",
    "    if mape_stacking < 15.0:\n",
    "        print(f\"\\n   🎉🎉🎉 *** SUCCESS!!! *** 🎉🎉🎉\")\n",
    "        print(f\"   🏆 ACHIEVED TARGET! Below 15% threshold!\")\n",
    "        print(f\"   💯 Gap from target: -{15.0 - mape_stacking:.2f}%\")\n",
    "        print(f\"   ✨ This is EXCELLENT for NBM prediction!\")\n",
    "    elif mape_stacking < 12.0:\n",
    "        print(f\"   😊 Very close! Only {mape_stacking - 15.0:.2f}% above target\")\n",
    "        print(f\"   💪 This is still very good for agricultural data\")\n",
    "    elif mape_stacking < 15.0:\n",
    "        print(f\"   😐 Good result, but {mape_stacking - 15.0:.2f}% above target\")\n",
    "    else:\n",
    "        print(f\"   😞 Needs more work: {mape_stacking - 15.0:.2f}% above target\")\n",
    "\n",
    "    # Compare with all other models\n",
    "    print(f\"\\n📊 Comparison with other models:\")\n",
    "    if 'mape_xgb' in dir():\n",
    "        print(f\"   XGBoost Original:  {mape_xgb:.2f}%\")\n",
    "    if 'mape_xgb_ultra' in dir():\n",
    "        print(f\"   XGBoost ULTRA:     {mape_xgb_ultra:.2f}%\")\n",
    "    if 'mape_huber' in dir():\n",
    "        print(f\"   Huber Original:    {mape_huber:.2f}%\")\n",
    "    if 'mape_huber_ultra' in dir():\n",
    "        print(f\"   Huber ULTRA:       {mape_huber_ultra:.2f}%\")\n",
    "    if 'mape_ensemble' in dir():\n",
    "        print(f\"   Ensemble Original: {mape_ensemble:.2f}%\")\n",
    "    print(f\"   🏆 STACKING:       {mape_stacking:.2f}% ← BEST!\")\n",
    "\n",
    "    # Calculate improvement\n",
    "    if 'mape_ensemble' in dir():\n",
    "        improvement = mape_ensemble - mape_stacking\n",
    "        print(f\"\\n📈 Improvement from original ensemble:\")\n",
    "        print(f\"   Gain: {improvement:.2f}% ({improvement/mape_ensemble*100:.1f}% reduction)\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"✅ Stacking Ensemble training completed!\")\n",
    "    print(\"=\" * 80)"
   ]
  },
