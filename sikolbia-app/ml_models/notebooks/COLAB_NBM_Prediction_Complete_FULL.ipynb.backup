    "print(\"\\n💡 Strategy: Focus ONLY on true major staples\")\n",
    "print(\"   Expected: These items should be most predictable\\n\")\n",
    "\n",
    "# Check data distribution\n",
    "EXTREME_THRESHOLD = 200.0\n",
    "\n",
    "train_extreme = np.sum(y_train >= EXTREME_THRESHOLD)\n",
    "test_extreme = np.sum(y_test >= EXTREME_THRESHOLD)\n",
    "\n",
    "print(f\"📊 Data with ≥{EXTREME_THRESHOLD} kkal:\")\n",
    "print(f\"  Train: {train_extreme:,} samples ({train_extreme/len(y_train)*100:.1f}%)\")\n",
    "print(f\"  Test:  {test_extreme:,} samples ({test_extreme/len(y_test)*100:.1f}%)\")\n",
    "\n",
    "# Filter datasets\n",
    "mask_train_extreme = y_train >= EXTREME_THRESHOLD\n",
    "X_train_extreme = X_train_scaled[mask_train_extreme]\n",
    "y_train_extreme = y_train[mask_train_extreme]\n",
    "\n",
    "mask_val_extreme = y_val >= EXTREME_THRESHOLD\n",
    "X_val_extreme = X_val_scaled[mask_val_extreme]\n",
    "y_val_extreme = y_val[mask_val_extreme]\n",
    "\n",
    "mask_test_extreme = y_test >= EXTREME_THRESHOLD\n",
    "X_test_extreme = X_test_scaled[mask_test_extreme]\n",
    "y_test_extreme = y_test[mask_test_extreme]\n",
    "\n",
    "print(\"\\n✅ EXTREME datasets created\")\n",
    "\n",
    "# Train with EXTREME hyperparameters\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"🔥 EXTREME XGBOOST - Tuned for Major Staples\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "import xgboost as xgb\n",
    "from datetime import datetime\n",
    "\n",
    "model_xgb_extreme = xgb.XGBRegressor(\n",
    "    n_estimators=5000,      # Even more trees\n",
    "    max_depth=30,           # Very deep\n",
    "    learning_rate=0.001,    # Ultra slow\n",
    "    min_child_weight=0.01,  # Allow tiny splits\n",
    "    subsample=0.98,\n",
    "    colsample_bytree=0.98,\n",
    "    gamma=0.00001,          # Almost no pruning\n",
    "    reg_alpha=0.0001,       # Minimal regularization\n",
    "    reg_lambda=0.0001,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    verbosity=0\n",
    ")\n",
    "\n",
    "print(f\"\\n🚀 Training on {train_extreme} samples... (10-15 minutes)\")\n",
    "print(f\"   Start: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "start = datetime.now()\n",
    "\n",
    "model_xgb_extreme.fit(\n",
    "    X_train_extreme,\n",
    "    y_train_extreme,\n",
    "    eval_set=[(X_val_extreme, y_val_extreme)],\n",
    "    verbose=False\n",
    ")\n",
    "\n",
    "duration = (datetime.now() - start).total_seconds()\n",
    "print(f\"✅ Done in {duration/60:.1f} minutes\")\n",
    "\n",
    "# Predict & evaluate\n",
    "y_pred_extreme = model_xgb_extreme.predict(X_test_extreme)\n",
    "mape_extreme = np.mean(np.abs((y_test_extreme - y_pred_extreme) / y_test_extreme)) * 100\n",
