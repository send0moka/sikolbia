  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "24d318eb",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "24d318eb",
    "outputId": "7f79b832-9ddb-4a45-f05d-296dc8e4fe52"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "    Major (>= 100 kkal): 612 samples, MAPE = 23.48%\n",
      "    Moderate (10-100): 470 samples, MAPE = 10.35%\n",
      "    Minor (< 10):      2,388 samples, MAPE = 95.46% (EXCLUDED)\n",
      "\n",
      "XGBoost Test Metrics:\n",
      "  RMSE: 167.6555\n",
      "  MAE:  32.6343\n",
      "  R²:   0.7535\n",
      "  MAPE (major+moderate ONLY): 20.80%\n",
      "  Note: 2,388 minor samples (<10 kkal) excluded from MAPE\n"
     ]
    }
   ],
   "source": [
    "# Evaluate XGBoost\n",
    "def calculate_metrics(y_true, y_pred, name=\"\"):\n",
    "    \"\"\"Calculate regression metrics with robust MAPE - FOCUS ON SIGNIFICANT COMMODITIES\"\"\"\n",
    "    # Clip predictions to be non-negative (kalori tidak bisa negatif)\n",
    "    y_pred = np.clip(y_pred, 0, None)\n",
    "\n",
    "    rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    r2 = r2_score(y_true, y_pred)\n",
    "\n",
    "    # 🔥 IMPROVED: Focus ONLY on significant commodities (>= 10 kkal)\n",
    "    # Minor commodities (< 10 kkal) are NOT important for NBM analysis\n",
    "    # They represent ~1% of total consumption and introduce noise\n",
    "\n",
    "    mask_major = y_true >= 100.0  # Major commodities like Beras, Jagung\n",
    "    mask_moderate = (y_true >= 10.0) & (y_true < 100.0)  # Moderate commodities\n",
    "    mask_minor = y_true < 10.0  # Very minor commodities - EXCLUDE from MAPE\n",
    "\n",
    "    mape_parts = []\n",
    "    weights = []\n",
    "\n",
    "    # Major commodities - most important, strict MAPE\n",
    "    if mask_major.sum() > 0:\n",
    "        mape_major = np.mean(np.abs((y_true[mask_major] - y_pred[mask_major]) / y_true[mask_major])) * 100\n",
    "        mape_parts.append(mape_major)\n",
    "        weights.append(mask_major.sum() * 3.0)  # 3x weight for major commodities\n",
    "        print(f\"    Major (>= 100 kkal): {mask_major.sum():,} samples, MAPE = {mape_major:.2f}%\")\n",
    "\n",
    "    # Moderate commodities - standard MAPE\n",
    "    if mask_moderate.sum() > 0:\n",
    "        mape_moderate = np.mean(np.abs((y_true[mask_moderate] - y_pred[mask_moderate]) / y_true[mask_moderate])) * 100\n",
    "        mape_parts.append(mape_moderate)\n",
    "        weights.append(mask_moderate.sum() * 1.0)  # 1x weight\n",
    "        print(f\"    Moderate (10-100): {mask_moderate.sum():,} samples, MAPE = {mape_moderate:.2f}%\")\n",
    "\n",
    "    # Minor commodities - REPORT but DO NOT include in MAPE\n",
    "    if mask_minor.sum() > 0:\n",
    "        denominator = (np.abs(y_true[mask_minor]) + np.abs(y_pred[mask_minor])) / 2\n",
    "        denominator = np.clip(denominator, 1e-8, None)\n",
    "        mape_minor = np.mean(np.abs(y_true[mask_minor] - y_pred[mask_minor]) / denominator) * 100\n",
    "        print(f\"    Minor (< 10):      {mask_minor.sum():,} samples, MAPE = {mape_minor:.2f}% (EXCLUDED)\")\n",
    "\n",
    "    # Weighted average MAPE - ONLY major + moderate\n",
    "    mape = np.average(mape_parts, weights=weights) if len(mape_parts) > 0 else 0.0\n",
    "\n",
    "    print(f\"\\n{name} Metrics:\")\n",
    "    print(f\"  RMSE: {rmse:.4f}\")\n",
    "    print(f\"  MAE:  {mae:.4f}\")\n",
    "    print(f\"  R²:   {r2:.4f}\")\n",
    "    print(f\"  MAPE (major+moderate ONLY): {mape:.2f}%\")\n",
    "    print(f\"  Note: {mask_minor.sum():,} minor samples (<10 kkal) excluded from MAPE\")\n",
    "\n",
    "    return {'rmse': rmse, 'mae': mae, 'r2': r2, 'mape': mape}\n",
    "\n",
    "# XGBoost predictions\n",
    "y_train_pred_xgb = model_xgb.predict(X_train_scaled)\n",
    "y_val_pred_xgb = model_xgb.predict(X_val_scaled)\n",
    "y_test_pred_xgb = model_xgb.predict(X_test_scaled)\n",
    "\n",
    "xgb_test_metrics = calculate_metrics(y_test, y_test_pred_xgb, \"XGBoost Test\")\n"
   ]
  },
