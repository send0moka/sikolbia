   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🎯 STRATEGY 2: POLYNOMIAL FEATURE ENGINEERING\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "from sklearn.preprocessing import PolynomialFeatures, StandardScaler\n",
    "from datetime import datetime\n",
    "\n",
    "if 'X_test_nuclear' not in dir():\n",
    "    print(\"\\n❌ ERROR: Run NUCLEAR cell first!\")\n",
    "else:\n",
    "    # Create validation set if not exists\n",
    "    if 'X_val_nuclear' not in dir() or len(X_val_nuclear) == 0:\n",
    "        print(\"\\n⚠️ Creating validation set from training data...\")\n",
    "        from sklearn.model_selection import train_test_split\n",
    "        X_train_nuclear_split, X_val_nuclear, y_train_nuclear_split, y_val_nuclear = train_test_split(\n",
    "            X_train_nuclear, y_train_nuclear, test_size=0.2, random_state=42\n",
    "        )\n",
    "        print(f\"   Train: {len(X_train_nuclear_split)} samples\")\n",
    "        print(f\"   Val:   {len(X_val_nuclear)} samples\")\n",
    "    else:\n",
    "        X_train_nuclear_split = X_train_nuclear\n",
    "        y_train_nuclear_split = y_train_nuclear\n",
    "\n",
    "    print(\"\\n🔧 Creating polynomial features...\")\n",
    "    print(\"  • Degree 2 polynomials\")\n",
    "    print(\"  • Interaction terms between all features\")\n",
    "\n",
    "    # Create polynomial features\n",
    "    poly = PolynomialFeatures(degree=2, include_bias=False, interaction_only=False)\n",
    "\n",
    "    print(\"\\n⚙️ Fitting polynomial transformer...\")\n",
    "    X_train_poly = poly.fit_transform(X_train_nuclear_split)\n",
    "    X_test_poly = poly.transform(X_test_nuclear)\n",
    "    X_val_poly = poly.transform(X_val_nuclear)\n",
    "\n",
    "    print(f\"✅ Original features: {X_train_nuclear.shape[1]}\")\n",
    "    print(f\"✅ Polynomial features: {X_train_poly.shape[1]}\")\n",
    "    print(f\"   Expansion: {X_train_poly.shape[1] / X_train_nuclear.shape[1]:.1f}x\")\n",
    "\n",
    "    # Scale features (important for polynomial features)\n",
    "    print(\"\\n📏 Scaling features...\")\n",
    "    scaler_poly = StandardScaler()\n",
    "    X_train_poly_scaled = scaler_poly.fit_transform(X_train_poly)\n",
    "    X_test_poly_scaled = scaler_poly.transform(X_test_poly)\n",
    "    X_val_poly_scaled = scaler_poly.transform(X_val_poly)\n",
    "\n",
    "    # Train XGBoost on polynomial features\n",
    "    print(\"\\n🎯 Training XGBoost with polynomial features...\")\n",
    "    print(\"  Config: 3000 trees, depth 25, lr 0.002\")\n",
    "\n",
    "    model_poly = xgb.XGBRegressor(\n",
    "        n_estimators=3000,\n",
    "        max_depth=25,\n",
    "        learning_rate=0.002,\n",
    "        min_child_weight=1,\n",
    "        subsample=0.9,\n",
    "        colsample_bytree=0.9,\n",
    "        colsample_bylevel=0.9,  # Also subsample columns per level\n",
    "        gamma=0.001,\n",
    "        reg_alpha=0.01,\n",
    "        reg_lambda=0.01,\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "        verbosity=0\n",
    "    )\n",
    "\n",
    "    print(f\"\\n🚀 Training... (20-30 minutes)\")\n",
    "    print(f\"   Start: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "    start = datetime.now()\n",
    "\n",
    "    model_poly.fit(\n",
    "        X_train_poly_scaled,\n",
    "        y_train_nuclear_split,\n",
    "        eval_set=[(X_val_poly_scaled, y_val_nuclear)],\n",
    "        verbose=False\n",
    "    )\n",
    "\n",
    "    duration = (datetime.now() - start).total_seconds()\n",
    "    print(f\"✅ Done in {duration/60:.1f} minutes\")\n",
    "\n",
    "    # Predict\n",
    "    y_pred_poly = model_poly.predict(X_test_poly_scaled)\n",
    "    mape_poly = np.mean(np.abs((y_test_nuclear - y_pred_poly) / y_test_nuclear)) * 100\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"📊 POLYNOMIAL FEATURES MODEL RESULTS\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"\\n🎯 MAPE: {mape_poly:.2f}%\")\n",
    "\n",
    "    if mape_poly < 15.0:\n",
    "        print(f\"\\n   🎉🎉🎉 *** SUCCESS!!! ***\")\n",
    "        print(f\"   🏆 ACHIEVED <15% TARGET!\")\n",
    "        print(f\"   Gap: -{15.0 - mape_poly:.2f}%\")\n",
    "    elif mape_poly < 12.0:\n",
    "        print(f\"\\n   😊 Very close! Gap: +{mape_poly - 15.0:.2f}%\")\n",
    "    else:\n",
    "        print(f\"\\n   😞 Gap: +{mape_poly - 15.0:.2f}%\")\n",
    "\n",
    "    # Compare\n",
    "    if 'mape_nuclear' in dir():\n",
    "        improvement = mape_nuclear - mape_poly\n",
    "        print(f\"\\n📈 vs NUCLEAR XGBoost:\")\n",
    "        print(f\"   NUCLEAR:    {mape_nuclear:.2f}%\")\n",
    "        print(f\"   Polynomial: {mape_poly:.2f}%\")\n",
    "        if improvement > 0:\n",
    "            print(f\"   Gain:       {improvement:.2f}% ✅\")\n",
    "        else:\n",
    "            print(f\"   Loss:       {abs(improvement):.2f}% ❌\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)"
   ]
