   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🔥🔥🔥 COMBINED: FILTER DATA + XGBOOST ULTRA 🔥🔥🔥\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# ============================================================================\n",
    "# PART 1: FILTER MINOR COMMODITIES\n",
    "# ============================================================================\n",
    "print(\"\\n🎯 STEP 1: FILTERING TRAINING DATA...\")\n",
    "\n",
    "# Filter training data (>= 10 kkal only)\n",
    "mask_train_significant = y_train >= 10.0\n",
    "X_train_filtered = X_train_scaled[mask_train_significant]\n",
    "y_train_filtered = y_train[mask_train_significant]\n",
    "\n",
    "# Filter validation data\n",
    "mask_val_significant = y_val >= 10.0\n",
    "X_val_filtered = X_val_scaled[mask_val_significant]\n",
    "y_val_filtered = y_val[mask_val_significant]\n",
    "\n",
    "# Filter test data\n",
    "mask_test_significant = y_test >= 10.0\n",
    "X_test_filtered = X_test_scaled[mask_test_significant]\n",
    "y_test_filtered = y_test[mask_test_significant]\n",
    "\n",
    "print(f\"\\n📊 Dataset Filtering:\")\n",
    "print(f\"  Original train: {len(y_train):,} samples\")\n",
    "print(f\"  Filtered train: {len(y_train_filtered):,} samples ({len(y_train_filtered)/len(y_train)*100:.1f}%)\")\n",
    "print(f\"  Removed: {len(y_train) - len(y_train_filtered):,} minor samples\")\n",
    "print(f\"\\n  Original test:  {len(y_test):,} samples\")\n",
    "print(f\"  Filtered test:  {len(y_test_filtered):,} samples ({len(y_test_filtered)/len(y_test)*100:.1f}%)\")\n",
    "\n",
    "print(f\"\\n✅ Filtered datasets created successfully!\")\n",
    "\n",
    "# ============================================================================\n",
    "# PART 2: TRAIN XGBOOST ULTRA ON FILTERED DATA\n",
    "# ============================================================================\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"🎯 STEP 2: TRAINING XGBOOST ULTRA (EXTREME PARAMETERS)...\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "import xgboost as xgb\n",
    "from datetime import datetime\n",
    "\n",
    "# ULTRA AGGRESSIVE XGBoost configuration\n",
    "print(\"\\n📋 XGBoost ULTRA Configuration:\")\n",
    "print(\"  • n_estimators: 1000 (from 300)\")\n",
    "print(\"  • max_depth: 15 (from 9)\")\n",
    "print(\"  • learning_rate: 0.01 (from 0.025)\")\n",
    "print(\"  • min_child_weight: 1\")\n",
    "print(\"  • subsample: 0.8\")\n",
    "print(\"  • colsample_bytree: 0.8\")\n",
    "print(\"  • early_stopping_rounds: 50\")\n",
    "print(\"  • Training on FILTERED data only (major + moderate commodities)\")\n",
    "\n",
    "model_xgb_ultra = xgb.XGBRegressor(\n",
    "    n_estimators=1000,\n",
    "    max_depth=15,\n",
    "    learning_rate=0.01,\n",
    "    min_child_weight=1,\n",
    "    subsample=0.8,\n",
    "    colsample_bytree=0.8,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    verbosity=1\n",
    ")\n",
    "\n",
    "print(\"\\n🚀 Training XGBoost ULTRA... (This will take 15-20 minutes)\")\n",
    "print(f\"   Start time: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "start_time = datetime.now()\n",
    "\n",
    "# Train with early stopping\n",
    "model_xgb_ultra.fit(\n",
    "    X_train_filtered,\n",
    "    y_train_filtered,\n",
    "    eval_set=[(X_val_filtered, y_val_filtered)],\n",
    "    verbose=50\n",
    ")\n",
    "\n",
    "end_time = datetime.now()\n",
    "duration = (end_time - start_time).total_seconds()\n",
    "print(f\"\\n✅ Training completed in {duration/60:.1f} minutes\")\n",
    "print(f\"   End time: {end_time.strftime('%H:%M:%S')}\")\n",
    "\n",
    "# Predict on filtered test data\n",
    "print(\"\\n🎯 Evaluating on filtered test data...\")\n",
    "y_test_pred_xgb_ultra = model_xgb_ultra.predict(X_test_filtered)\n",
    "\n",
    "# Calculate MAPE\n",
    "mape_xgb_ultra = np.mean(np.abs((y_test_filtered - y_test_pred_xgb_ultra) / y_test_filtered)) * 100\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"📊 XGBOOST ULTRA RESULTS (Filtered Data)\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"\\n🎯 MAPE: {mape_xgb_ultra:.2f}%\")\n",
    "\n",
    "if mape_xgb_ultra < 15.0:\n",
    "    print(f\"   🎉🎉🎉 SUCCESS! Below 15% target!\")\n",
    "    print(f\"   Gap from target: -{15.0 - mape_xgb_ultra:.2f}%\")\n",
    "elif mape_xgb_ultra < 12.0:\n",
    "    print(f\"   😊 Very close! Only {mape_xgb_ultra - 15.0:.2f}% above target\")\n",
    "elif mape_xgb_ultra < 15.0:\n",
    "    print(f\"   😐 Good improvement, but {mape_xgb_ultra - 15.0:.2f}% above target\")\n",
    "else:\n",
    "    print(f\"   😞 Still needs work: {mape_xgb_ultra - 15.0:.2f}% above target\")\n",
    "\n",
    "# Comparison with original\n",
    "if 'mape_xgb' in dir():\n",
    "    improvement = mape_xgb - mape_xgb_ultra\n",
    "    print(f\"\\n📈 Improvement from original XGBoost:\")\n",
    "    print(f\"   Original: {mape_xgb:.2f}%\")\n",
    "    print(f\"   ULTRA:    {mape_xgb_ultra:.2f}%\")\n",
    "    print(f\"   Gain:     {improvement:.2f}% ({improvement/mape_xgb*100:.1f}% reduction)\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"✅ XGBoost ULTRA training completed!\")\n",
    "print(\"=\" * 80)"
   ]
  },
