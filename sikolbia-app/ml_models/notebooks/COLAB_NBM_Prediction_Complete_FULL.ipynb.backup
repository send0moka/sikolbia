   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🔥 STRATEGY 1: SUPER AGGRESSIVE LSTM on EXTREME Data\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Use EXTREME filtered data (≥200 kkal) - most predictable\n",
    "if 'X_train_extreme' not in dir():\n",
    "    print(\"\\n❌ ERROR: Run EXTREME filtering cell first!\")\n",
    "else:\n",
    "    print(\"\\n💪 Training SUPER AGGRESSIVE LSTM...\")\n",
    "    print(\"   Data: ≥200 kkal (major staples only)\")\n",
    "    print(\"   Strategy: Deep LSTM + aggressive tuning\\n\")\n",
    "\n",
    "    from tensorflow.keras.models import Sequential\n",
    "    from tensorflow.keras.layers import LSTM, Dense, Dropout, BatchNormalization\n",
    "    from tensorflow.keras.optimizers import Adam\n",
    "    from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n",
    "    from sklearn.preprocessing import StandardScaler\n",
    "    import tensorflow as tf\n",
    "\n",
    "    # Prepare sequences for LSTM\n",
    "    sequence_length = 6\n",
    "\n",
    "    # Need to reshape for LSTM: (samples, timesteps, features)\n",
    "    # For now, use simple approach: repeat features across timesteps\n",
    "    X_train_lstm_extreme = np.repeat(X_train_extreme[:, np.newaxis, :], sequence_length, axis=1)\n",
    "    X_val_lstm_extreme = np.repeat(X_val_extreme[:, np.newaxis, :], sequence_length, axis=1)\n",
    "    X_test_lstm_extreme = np.repeat(X_test_extreme[:, np.newaxis, :], sequence_length, axis=1)\n",
    "\n",
    "    print(f\"📊 LSTM input shape: {X_train_lstm_extreme.shape}\")\n",
    "    print(f\"   Samples: {X_train_lstm_extreme.shape[0]}\")\n",
    "    print(f\"   Timesteps: {X_train_lstm_extreme.shape[1]}\")\n",
    "    print(f\"   Features: {X_train_lstm_extreme.shape[2]}\")\n",
    "\n",
    "    # Build SUPER AGGRESSIVE LSTM\n",
    "    print(\"\\n🏗️ Building DEEP LSTM architecture...\")\n",
    "    model_lstm_extreme = Sequential([\n",
    "        LSTM(256, return_sequences=True, input_shape=(sequence_length, X_train_extreme.shape[1])),\n",
    "        Dropout(0.2),\n",
    "        BatchNormalization(),\n",
    "\n",
    "        LSTM(128, return_sequences=True),\n",
    "        Dropout(0.2),\n",
    "        BatchNormalization(),\n",
    "\n",
    "        LSTM(64, return_sequences=False),\n",
    "        Dropout(0.2),\n",
    "        BatchNormalization(),\n",
    "\n",
    "        Dense(128, activation='relu'),\n",
    "        Dropout(0.2),\n",
    "        BatchNormalization(),\n",
    "\n",
    "        Dense(64, activation='relu'),\n",
    "        Dropout(0.2),\n",
    "\n",
    "        Dense(32, activation='relu'),\n",
    "        Dense(1)\n",
    "    ])\n",
    "\n",
    "    # Compile with aggressive learning\n",
    "    optimizer = Adam(learning_rate=0.001, clipnorm=1.0)\n",
    "    model_lstm_extreme.compile(\n",
    "        optimizer=optimizer,\n",
    "        loss='mse',\n",
    "        metrics=['mae']\n",
    "    )\n",
    "\n",
    "    print(\"✅ Model built:\")\n",
    "    print(f\"   Total params: {model_lstm_extreme.count_params():,}\")\n",
    "    print(f\"   3 LSTM layers: 256 → 128 → 64 units\")\n",
    "    print(f\"   3 Dense layers with dropout & batch norm\")\n",
    "\n",
    "    # Callbacks\n",
    "    early_stop = EarlyStopping(\n",
    "        monitor='val_loss',\n",
    "        patience=100,\n",
    "        restore_best_weights=True,\n",
    "        verbose=1\n",
    "    )\n",
    "\n",
    "    reduce_lr = ReduceLROnPlateau(\n",
    "        monitor='val_loss',\n",
    "        factor=0.5,\n",
    "        patience=20,\n",
    "        min_lr=1e-7,\n",
    "        verbose=1\n",
    "    )\n",
    "\n",
    "    print(\"\\n🚀 Training SUPER AGGRESSIVE LSTM... (15-20 minutes)\")\n",
    "    print(f\"   Start: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "    start = datetime.now()\n",
    "\n",
    "    history = model_lstm_extreme.fit(\n",
    "        X_train_lstm_extreme,\n",
    "        y_train_extreme,\n",
    "        validation_data=(X_val_lstm_extreme, y_val_extreme),\n",
    "        epochs=500,\n",
    "        batch_size=16,\n",
    "        callbacks=[early_stop, reduce_lr],\n",
    "        verbose=0\n",
    "    )\n",
    "\n",
    "    duration = (datetime.now() - start).total_seconds()\n",
    "    print(f\"✅ Done in {duration/60:.1f} minutes\")\n",
    "    print(f\"   Epochs trained: {len(history.history['loss'])}\")\n",
    "\n",
    "    # Predict\n",
    "    y_pred_lstm_extreme = model_lstm_extreme.predict(X_test_lstm_extreme, verbose=0).flatten()\n",
    "    mape_lstm_extreme = np.mean(np.abs((y_test_extreme - y_pred_lstm_extreme) / y_test_extreme)) * 100\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🔥 SUPER AGGRESSIVE LSTM RESULTS\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"\\n🎯 MAPE: {mape_lstm_extreme:.2f}%\")\n",
    "\n",
    "    if mape_lstm_extreme < 15.0:\n",
    "        print(f\"\\n   🔥🔥🔥 *** LSTM SUCCESS!!! ***\")\n",
    "        print(f\"   🏆 LSTM ALONE ACHIEVED <15%!\")\n",
    "        print(f\"   Gap: -{15.0 - mape_lstm_extreme:.2f}%\")\n",
    "    elif mape_lstm_extreme < 20.0:\n",
    "        print(f\"\\n   😊 Good progress! Gap: +{mape_lstm_extreme - 15.0:.2f}%\")\n",
    "        print(f\"   💡 Will ensemble with XGBoost next!\")\n",
    "    elif mape_lstm_extreme < 30.0:\n",
    "        print(f\"\\n   😐 Moderate performance. Gap: +{mape_lstm_extreme - 15.0:.2f}%\")\n",
    "        print(f\"   💡 Ensemble should help significantly\")\n",
    "    else:\n",
    "        print(f\"\\n   😞 LSTM struggling. Gap: +{mape_lstm_extreme - 15.0:.2f}%\")\n",
    "        print(f\"   💡 Will heavily weight XGBoost in ensemble\")\n",
    "\n",
    "    # Compare\n",
    "    if 'mape_extreme' in dir():\n",
