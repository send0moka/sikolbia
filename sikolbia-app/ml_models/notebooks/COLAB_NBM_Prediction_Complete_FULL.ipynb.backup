   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🏁 ULTIMATE FINAL VERDICT - ALL EMERGENCY STRATEGIES\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\n📊 COMPLETE STRATEGY COMPARISON:\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Collect all results\n",
    "all_results = []\n",
    "\n",
    "# Original strategies\n",
    "all_results.append((\"Original Ensemble (3-way)\", 18.75, \"❌\"))\n",
    "all_results.append((\"LSTM Enhanced ULTRA (≥10 kkal)\", 19.11, \"❌\"))\n",
    "all_results.append((\"MEGA Ensemble (≥50 kkal)\", 16.52, \"❌\"))\n",
    "all_results.append((\"NUCLEAR XGBoost (≥100 kkal)\", 14.04, \"❌\"))\n",
    "all_results.append((\"Commodity-Aware (≥100 kkal)\", 13.45, \"❌\"))\n",
    "all_results.append((\"Super Ensemble (3-way)\", 14.08, \"❌\"))\n",
    "all_results.append((\"EXTREME XGBoost (≥200 kkal)\", 13.38, \"❌\"))\n",
    "\n",
    "# FINAL BATTLE strategies\n",
    "all_results.append((\"LSTM Enhanced (2-way: XGBoost+LSTM)\", 13.22, \"😐\"))\n",
    "\n",
    "# EMERGENCY strategies (check if they exist)\n",
    "if 'mape_multi_range' in dir():\n",
    "    status = \"🎉\" if mape_multi_range < 10 else \"😊\" if mape_multi_range < 12 else \"😐\"\n",
    "    all_results.append((\"Multi-Range Models\", mape_multi_range, status))\n",
    "\n",
    "if 'mape_engineered' in dir():\n",
    "    status = \"🎉\" if mape_engineered < 10 else \"😊\" if mape_engineered < 12 else \"😐\"\n",
    "    all_results.append((\"Extreme Feature Engineering\", mape_engineered, status))\n",
    "\n",
    "if 'best_mape_optuna' in dir():\n",
    "    status = \"🎉\" if best_mape_optuna < 10 else \"😊\" if best_mape_optuna < 12 else \"😐\"\n",
    "    all_results.append((\"Optuna Hyperparameter Tuning\", best_mape_optuna, status))\n",
    "\n",
    "# Sort by MAPE\n",
    "all_results.sort(key=lambda x: x[1])\n",
    "\n",
    "print(\"\\n🏆 FINAL RANKING (Best to Worst):\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"{'Rank':<6} {'Strategy':<45} {'MAPE':<10} {'Status'}\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for rank, (name, mape, status) in enumerate(all_results, 1):\n",
    "    gap = f\"+{mape - 15.0:.2f}%\" if mape >= 10 else f\"-{10.0 - mape:.2f}%\"\n",
    "    print(f\"{rank:<6} {name:<45} {mape:>6.2f}%  {gap:>8}  {status}\")\n",
    "\n",
    "print(\"-\" * 80)\n",
    "\n",
    "# Find absolute best\n",
    "best_name, best_mape, best_status = all_results[0]\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"🏆 ABSOLUTE BEST MODEL\")\n",
    "print(\"=\" * 80)\n",
    "\n",
