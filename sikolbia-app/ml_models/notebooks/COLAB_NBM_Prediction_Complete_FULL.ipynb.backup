     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "After removing NaN: 34,694 rows (2,890 removed)\n",
      "\n",
      "✓ X shape: (34694, 27)\n",
      "✓ y shape: (34694,)\n",
