    "print(\"=\" * 80)\n",
    "print(\"MODEL 1: XGBOOST - AGGRESSIVE TUNING\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "\n",
    "# 🔥 AGGRESSIVE XGBoost GridSearch - target < 15%\n",
    "param_grid = {\n",
    "    'n_estimators': [250, 300],\n",
    "    'max_depth': [8, 9],\n",
    "    'learning_rate': [0.025, 0.03],\n",
    "    'subsample': [0.85, 0.9],\n",
    "    'colsample_bytree': [0.85, 0.9],\n",
