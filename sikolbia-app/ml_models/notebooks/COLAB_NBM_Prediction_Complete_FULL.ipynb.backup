    "    'kalori_ma_3', 'kalori_ma_6', 'kalori_ma_12',\n",
    "\n",
    "    # Growth\n",
    "    'kalori_growth_yoy',\n",
    "\n",
    "    # Temporal\n",
    "    'month_sin', 'month_cos', 'is_harvest_season', 'is_rainy_season',\n",
    "\n",
