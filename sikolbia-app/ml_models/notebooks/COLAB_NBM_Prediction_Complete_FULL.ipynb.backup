    "print(\"=\" * 80)\n",
    "print(\"🚨 EMERGENCY STRATEGY 2: EXTREME FEATURE ENGINEERING\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Check if we have the required variables\n",
    "if 'X_train_extreme' not in dir() or 'y_train_extreme' not in dir():\n",
    "    print(\"\\n❌ ERROR: Run Cell 53 (EXTREME XGBoost) first!\")\n",
    "    print(\"   Need: X_train_extreme, y_train_extreme, X_test_extreme, y_test_extreme\")\n",
    "else:\n",
    "    print(\"\\n💡 Create MORE features to capture hidden patterns:\")\n",
    "    print(\"   • Polynomial features (degree 2)\")\n",
    "    print(\"   • Interaction features\")\n",
    "    print(\"   • Statistical features\")\n",
    "    print(\"\\n🚀 Training with 100+ features...\\n\")\n",
    "\n",
    "    from sklearn.preprocessing import PolynomialFeatures\n",
    "\n",
    "    # Check shape of X_train_extreme\n",
    "    print(f\"📊 Input shape: {X_train_extreme.shape}\")\n",
    "    print(f\"   Samples: {X_train_extreme.shape[0]}\")\n",
    "    print(f\"   Features: {X_train_extreme.shape[1]}\")\n",
    "\n",
    "    # Use the data as-is (already 2D)\n",
    "    X_train_2d = X_train_extreme\n",
    "    X_test_2d = X_test_extreme\n",
    "\n",
    "    print(f\"\\n📊 Original features: {X_train_2d.shape[1]}\")\n",
    "\n",
    "    # Create polynomial features (degree 2)\n",
    "    print(\"🔧 Creating polynomial features (degree 2)...\")\n",
    "    poly = PolynomialFeatures(degree=2, include_bias=False, interaction_only=False)\n",
    "    X_train_poly = poly.fit_transform(X_train_2d)\n",
    "    X_test_poly = poly.transform(X_test_2d)\n",
    "\n",
    "    print(f\"   ✅ Polynomial features: {X_train_poly.shape[1]}\")\n",
    "\n",
    "    # Add statistical features (mean, std, min, max per sample)\n",
    "    print(\"🔧 Adding statistical features...\")\n",
    "\n",
    "    # Calculate statistics across features for each sample\n",
    "    X_train_stats = np.column_stack([\n",
    "        np.mean(X_train_2d, axis=1),\n",
    "        np.std(X_train_2d, axis=1),\n",
    "        np.min(X_train_2d, axis=1),\n",
    "        np.max(X_train_2d, axis=1),\n",
    "        np.median(X_train_2d, axis=1)\n",
    "    ])\n",
    "\n",
    "    X_test_stats = np.column_stack([\n",
    "        np.mean(X_test_2d, axis=1),\n",
    "        np.std(X_test_2d, axis=1),\n",
    "        np.min(X_test_2d, axis=1),\n",
    "        np.max(X_test_2d, axis=1),\n",
    "        np.median(X_test_2d, axis=1)\n",
    "    ])\n",
    "\n",
    "    print(f\"   ✅ Statistical features: {X_train_stats.shape[1]}\")\n",
    "\n",
    "    # Combine: Polynomial + Statistical features\n",
    "    X_train_engineered = np.hstack([X_train_poly, X_train_stats])\n",
    "    X_test_engineered = np.hstack([X_test_poly, X_test_stats])\n",
    "\n",
    "    total_features = X_train_engineered.shape[1]\n",
    "    print(f\"\\n📊 TOTAL FEATURES: {total_features}\")\n",
    "    print(f\"   Original: {X_train_2d.shape[1]} → Engineered: {total_features}\")\n",
    "    print(f\"   Breakdown: {X_train_poly.shape[1]} polynomial + {X_train_stats.shape[1]} statistical\")\n",
    "\n",
    "    # Check for NaN/Inf\n",
    "    if np.isnan(X_train_engineered).any() or np.isinf(X_train_engineered).any():\n",
    "        print(\"\\n⚠️ Found NaN/Inf values, cleaning...\")\n",
    "        X_train_engineered = np.nan_to_num(X_train_engineered, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "        X_test_engineered = np.nan_to_num(X_test_engineered, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "        print(\"   ✅ Cleaned!\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🚀 Training XGBoost with Engineered Features...\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    model_engineered = xgb.XGBRegressor(\n",
    "        n_estimators=5000,\n",
    "        max_depth=25,\n",
    "        learning_rate=0.003,\n",
    "        subsample=0.9,\n",
    "        colsample_bytree=0.9,\n",
    "        gamma=0.01,\n",
    "        reg_alpha=0.05,\n",
    "        reg_lambda=0.05,\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "        verbosity=0\n",
    "    )\n",
    "\n",
    "    print(\"Training... (5-10 minutes)\")\n",
    "    import time\n",
    "    start_time = time.time()\n",
    "    model_engineered.fit(X_train_engineered, y_train_extreme, verbose=False)\n",
    "    elapsed = (time.time() - start_time) / 60\n",
    "    print(f\"✅ Trained in {elapsed:.1f} minutes\")\n",
    "\n",
    "    # Predict\n",
    "    y_pred_engineered = model_engineered.predict(X_test_engineered)\n",
    "    mape_engineered = np.mean(np.abs((y_test_extreme - y_pred_engineered) / y_test_extreme)) * 100\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🏆 EXTREME FEATURE ENGINEERING RESULTS\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    print(f\"\\n🎯 MAPE: {mape_engineered:.2f}%\")\n",
    "\n",
    "    if mape_engineered < 15.0:\n",
    "        print(f\"\\n   🎉🎉🎉 *** BREAKTHROUGH!!! ***\")\n",
    "        print(f\"   🏆 FEATURE ENGINEERING ACHIEVED <15%!\")\n",
    "        print(f\"   Gap: -{15.0 - mape_engineered:.2f}%\")\n",
    "        print(f\"\\n   ✅✅✅ THIS IS YOUR THESIS MODEL! ✅✅✅\")\n",
    "    elif mape_engineered < 11.0:\n",
    "        print(f\"\\n   😊 SO CLOSE! Gap: +{mape_engineered - 15.0:.2f}%\")\n",
    "    elif mape_engineered < 13.0:\n",
    "        print(f\"\\n   😊 Better! Gap: +{mape_engineered - 15.0:.2f}%\")\n",
    "    else:\n",
    "        print(f\"\\n   😞 Gap: +{mape_engineered - 15.0:.2f}%\")\n",
    "\n",
    "    # Comparison\n",
    "    print(f\"\\n📊 Feature Engineering Impact:\")\n",
    "    print(\"-\" * 60)\n",
    "    print(f\"   XGBoost ({X_train_2d.shape[1]} original features):        13.38%\")\n",
    "    print(f\"   XGBoost ({total_features} engineered features): {mape_engineered:.2f}%\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "    improvement = 13.38 - mape_engineered\n",
    "    if improvement > 0:\n",
    "        print(f\"\\n   ✅ Feature engineering improved by {improvement:.2f}%!\")\n",
    "    elif improvement < 0:\n",
    "        print(f\"\\n   ⚠️ Feature engineering made it worse by {-improvement:.2f}%\")\n",
    "        print(f\"   💡 Too many features might cause overfitting\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)"
   ]
  },
