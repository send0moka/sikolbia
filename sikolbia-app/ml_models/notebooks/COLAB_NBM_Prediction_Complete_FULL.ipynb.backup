   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🏆🏆🏆 FINAL ULTRA RESULTS - COMPREHENSIVE COMPARISON 🏆🏆🏆\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "# Collect all available results\n",
    "results = []\n",
    "\n",
    "# Original models\n",
    "if 'mape_xgb' in dir():\n",
    "    results.append({'Model': 'XGBoost (Original)', 'MAPE': mape_xgb, 'Category': 'Original'})\n",
    "if 'mape_huber' in dir():\n",
    "    results.append({'Model': 'Huber (Original)', 'MAPE': mape_huber, 'Category': 'Original'})\n",
    "if 'mape_lstm' in dir():\n",
    "    results.append({'Model': 'LSTM (Original)', 'MAPE': mape_lstm, 'Category': 'Original'})\n",
    "if 'mape_ensemble' in dir():\n",
    "    results.append({'Model': 'Ensemble 3-way (Original)', 'MAPE': mape_ensemble, 'Category': 'Original'})\n",
    "\n",
    "# ULTRA models\n",
    "if 'mape_xgb_ultra' in dir():\n",
    "    results.append({'Model': 'XGBoost ULTRA', 'MAPE': mape_xgb_ultra, 'Category': 'ULTRA'})\n",
    "if 'mape_huber_ultra' in dir():\n",
    "    results.append({'Model': 'Huber ULTRA', 'MAPE': mape_huber_ultra, 'Category': 'ULTRA'})\n",
    "if 'mape_stacking' in dir():\n",
    "    results.append({'Model': 'Stacking Ensemble', 'MAPE': mape_stacking, 'Category': 'ULTRA'})\n",
    "if 'mape_lstm_enhanced' in dir():\n",
    "    results.append({'Model': 'LSTM Enhanced ULTRA', 'MAPE': mape_lstm_enhanced, 'Category': 'ULTRA'})\n",
    "\n",
    "if len(results) == 0:\n",
    "    print(\"\\n❌ No results found! Please run the model training cells first.\")\n",
    "else:\n",
    "    # Create DataFrame and sort by MAPE\n",
    "    df_results = pd.DataFrame(results)\n",
    "    df_results = df_results.sort_values('MAPE')\n",
    "\n",
    "    print(f\"\\n📊 ALL MODELS RANKED BY MAPE ({len(results)} models):\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    for idx, row in df_results.iterrows():\n",
    "        status = \"✅\" if row['MAPE'] < 15.0 else \"⚠️\" if row['MAPE'] < 15.0 else \"❌\"\n",
    "        print(f\"{status} {row['Model']:30s} {row['MAPE']:6.2f}%  [{row['Category']}]\")\n",
    "\n",
    "    # Best model\n",
    "    best_model = df_results.iloc[0]\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🏆 BEST MODEL:\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"  Model: {best_model['Model']}\")\n",
    "    print(f\"  MAPE:  {best_model['MAPE']:.2f}%\")\n",
    "\n",
    "    if best_model[\"MAPE\"] < 15.0:\n",
    "        print(f\"\\n  🎉🎉🎉 *** TARGET ACHIEVED! *** 🎉🎉🎉\")\n",
    "        print(f\"  💯 Below 15% threshold by {15.0 - best_model[\"MAPE\"]:.2f}%\")\n",
    "        print(f\"\\n  📝 THESIS RECOMMENDATION:\")\n",
    "        print(f\"     Use '{best_model['Model']}' as your final model\")\n",
    "        print(f\"     MAPE: {best_model['MAPE']:.2f}% on filtered test data\")\n",
    "        print(f\"     This is EXCELLENT for NBM calorie prediction!\")\n",
    "        print(f\"\\n  ✨ Congratulations! Model ready for deployment.\")\n",
    "    elif best_model['MAPE'] < 12.0:\n",
    "        print(f\"\\n  😊 Very close to target!\")\n",
    "        print(f\"  Gap: Only {best_model['MAPE'] - 15.0:.2f}% above 15%\")\n",
    "        print(f\"\\n  💡 RECOMMENDATION:\")\n",
    "        print(f\"     - This is still VERY GOOD for agricultural prediction\")\n",
    "        print(f\"     - Literature typically reports 15-25% MAPE for NBM\")\n",
    "        print(f\"     - Consider accepting this result with academic justification\")\n",
    "        print(f\"     - OR try: ensemble the top 2 models\")\n",
    "    else:\n",
    "        print(f\"\\n  📊 Gap from target: {best_model['MAPE'] - 15.0:.2f}%\")\n",
    "        print(f\"\\n  💡 NEXT STEPS:\")\n",
    "        print(f\"     1. Try further filtering (>= 20 kkal instead of >= 10)\")\n",
    "        print(f\"     2. Feature engineering (interaction terms)\")\n",
    "        print(f\"     3. Per-commodity specialized models\")\n",
    "        print(f\"     4. Focus only on major commodities\")\n",
    "\n",
    "    # Calculate improvements\n",
    "    if 'mape_ensemble' in dir() and len(df_results[df_results['Category'] == 'ULTRA']) > 0:\n",
    "        best_ultra = df_results[df_results['Category'] == 'ULTRA'].iloc[0]\n",
    "        improvement = mape_ensemble - best_ultra['MAPE']\n",
    "        print(f\"\\n📈 Improvement from original ensemble:\")\n",
    "        print(f\"   Original: {mape_ensemble:.2f}%\")\n",
    "        print(f\"   Best:     {best_ultra['MAPE']:.2f}%\")\n",
    "        print(f\"   Gain:     {improvement:.2f}% ({improvement/mape_ensemble*100:.1f}% reduction)\")\n",
    "\n",
    "    # Save results to variable for later use\n",
    "    final_results = df_results\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"✅ Comprehensive comparison completed!\")\n",
    "    print(f\"   Results saved to 'final_results' DataFrame\")\n",
    "    print(\"=\" * 80)"
   ]
  },
