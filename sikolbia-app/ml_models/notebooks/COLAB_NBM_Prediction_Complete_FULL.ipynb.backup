   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🔥🔥🔥 MEGA LSTM ENHANCED ENSEMBLE (FINAL TRY) 🔥🔥🔥\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Combine MEGA XGBoost with original LSTM using smart weighting\n",
    "\n",
    "required = ['y_test_pred_xgb_mega', 'y_test_pred_lstm', 'y_test_mega', 'y_test', 'SEQUENCE_WINDOW']\n",
    "missing = [v for v in required if v not in dir()]\n",
    "\n",
    "if len(missing) > 0:\n",
    "    print(\"\\n❌ ERROR: Missing variables!\")\n",
    "    for m in missing:\n",
    "        print(f\"  • {m}\")\n",
    "    print(\"\\n📋 Run these first:\")\n",
    "    print(\"   1. LSTM cells (22-27)\")\n",
    "    print(\"   2. MEGA Filter cell\")\n",
    "    print(\"   3. MEGA XGBoost cell\")\n",
    "else:\n",
    "    print(\"\\n🎯 Creating MEGA LSTM Enhanced Ensemble...\")\n",
    "    print(\"  Strategy: XGBoost MEGA + LSTM (weighted)\")\n",
    "\n",
    "    # Find indices in original test that are MEGA filtered\n",
    "    test_indices_mega = np.where(y_test >= MEGA_THRESHOLD)[0]\n",
    "\n",
    "    # For LSTM: only keep indices >= SEQUENCE_WINDOW\n",
    "    valid_lstm_indices = test_indices_mega[test_indices_mega >= SEQUENCE_WINDOW]\n",
    "    lstm_pred_indices = valid_lstm_indices - SEQUENCE_WINDOW\n",
    "\n",
    "    # Map to MEGA positions\n",
    "    mega_positions = np.searchsorted(test_indices_mega, valid_lstm_indices)\n",
    "\n",
    "    print(f\"\\n📊 Alignment:\")\n",
    "    print(f\"  MEGA test samples: {len(y_test_mega):,}\")\n",
    "    print(f\"  Samples with LSTM: {len(valid_lstm_indices):,}\")\n",
    "    print(f\"  Percentage: {len(valid_lstm_indices)/len(y_test_mega)*100:.1f}%\")\n",
    "\n",
    "    if len(valid_lstm_indices) == 0:\n",
    "        print(\"\\n❌ ERROR: No samples for LSTM alignment!\")\n",
    "    elif lstm_pred_indices.max() >= len(y_test_pred_lstm):\n",
    "        print(f\"\\n❌ ERROR: LSTM index out of bounds!\")\n",
    "        print(f\"   Max index: {lstm_pred_indices.max()}, Array size: {len(y_test_pred_lstm)}\")\n",
    "    elif mega_positions.max() >= len(y_test_mega):\n",
    "        print(f\"\\n❌ ERROR: MEGA position out of bounds!\")\n",
    "        print(f\"   Max position: {mega_positions.max()}, Array size: {len(y_test_mega)}\")\n",
    "    else:\n",
    "        # Get aligned predictions\n",
    "        y_test_pred_lstm_aligned = y_test_pred_lstm[lstm_pred_indices]\n",
    "        y_test_pred_xgb_mega_aligned = y_test_pred_xgb_mega[mega_positions]\n",
    "        y_test_mega_aligned = y_test_mega[mega_positions]\n",
    "\n",
    "        # Calculate MAPE for each\n",
    "        mape_xgb_mega_aligned = np.mean(np.abs((y_test_mega_aligned - y_test_pred_xgb_mega_aligned) / y_test_mega_aligned)) * 100\n",
    "        mape_lstm_aligned = np.mean(np.abs((y_test_mega_aligned - y_test_pred_lstm_aligned) / y_test_mega_aligned)) * 100\n",
    "\n",
    "        print(f\"\\n📊 Component MAPE (aligned on MEGA data):\")\n",
    "        print(f\"  XGBoost MEGA: {mape_xgb_mega_aligned:.2f}%\")\n",
    "        print(f\"  LSTM:         {mape_lstm_aligned:.2f}%\")\n",
    "\n",
    "        # Inverse MAPE weighting\n",
    "        # If LSTM is bad, heavily penalize it\n",
    "        if mape_lstm_aligned > 50:\n",
    "            inv_lstm = 1.0 / (mape_lstm_aligned + 1) * 0.1  # 90% penalty\n",
    "            print(f\"\\n⚠️ LSTM very poor ({mape_lstm_aligned:.2f}%), applying 90% penalty\")\n",
    "        elif mape_lstm_aligned > 30:\n",
    "            inv_lstm = 1.0 / (mape_lstm_aligned + 1) * 0.3  # 70% penalty\n",
    "            print(f\"\\n⚠️ LSTM poor ({mape_lstm_aligned:.2f}%), applying 70% penalty\")\n",
    "        else:\n",
    "            inv_lstm = 1.0 / (mape_lstm_aligned + 1)\n",
    "\n",
    "        inv_xgb = 1.0 / (mape_xgb_mega_aligned + 1)\n",
    "\n",
    "        total_inv = inv_xgb + inv_lstm\n",
    "        w_xgb = inv_xgb / total_inv\n",
    "        w_lstm = inv_lstm / total_inv\n",
    "\n",
    "        print(f\"\\n⚖️ Weights:\")\n",
    "        print(f\"  XGBoost MEGA: {w_xgb:.3f} ({w_xgb*100:.1f}%)\")\n",
    "        print(f\"  LSTM:         {w_lstm:.3f} ({w_lstm*100:.1f}%)\")\n",
    "\n",
    "        # Ensemble\n",
    "        y_test_pred_mega_ensemble = (\n",
    "            w_xgb * y_test_pred_xgb_mega_aligned +\n",
    "            w_lstm * y_test_pred_lstm_aligned\n",
    "        )\n",
    "\n",
    "        # MAPE\n",
    "        mape_mega_ensemble = np.mean(np.abs((y_test_mega_aligned - y_test_pred_mega_ensemble) / y_test_mega_aligned)) * 100\n",
    "\n",
    "        print(\"\\n\" + \"=\" * 80)\n",
    "        print(\"📊 MEGA LSTM ENHANCED ENSEMBLE RESULTS\")\n",
    "        print(\"=\" * 80)\n",
    "        print(f\"\\n🎯 MAPE: {mape_mega_ensemble:.2f}%\")\n",
    "\n",
    "        if mape_mega_ensemble < 15.0:\n",
    "            print(f\"\\n   🎉🎉🎉 *** SUCCESS!!! ***\")\n",
    "            print(f\"   🏆 ACHIEVED <15% TARGET!\")\n",
    "            print(f\"   Gap: -{15.0 - mape_mega_ensemble:.2f}%\")\n",
    "            print(f\"   ✨ READY FOR THESIS!\")\n",
    "        elif mape_mega_ensemble < 12.0:\n",
    "            print(f\"\\n   😊 Very close! Gap: +{mape_mega_ensemble - 15.0:.2f}%\")\n",
    "            print(f\"   💪 Still excellent for NBM prediction\")\n",
    "        elif mape_mega_ensemble < 15.0:\n",
    "            print(f\"\\n   😐 Good result, gap: +{mape_mega_ensemble - 15.0:.2f}%\")\n",
    "        else:\n",
    "            print(f\"\\n   😞 Gap: +{mape_mega_ensemble - 15.0:.2f}%\")\n",
    "\n",
    "        # Final comparison\n",
    "        print(f\"\\n📊 All MEGA Strategy Results:\")\n",
    "        print(f\"   XGBoost MEGA:     {mape_xgb_mega_aligned:.2f}%\")\n",
    "        print(f\"   LSTM:             {mape_lstm_aligned:.2f}%\")\n",
    "        print(f\"   🏆 MEGA Ensemble: {mape_mega_ensemble:.2f}%\")\n",
    "\n",
    "        if 'mape_lstm_enhanced' in dir():\n",
    "            improvement = mape_lstm_enhanced - mape_mega_ensemble\n",
    "            print(f\"\\n📈 vs Previous Best (LSTM Enhanced ULTRA):\")\n",
    "            print(f\"   Previous: {mape_lstm_enhanced:.2f}%\")\n",
    "            print(f\"   MEGA:     {mape_mega_ensemble:.2f}%\")\n",
    "            if improvement > 0:\n",
    "                print(f\"   Gain:     {improvement:.2f}% ✅\")\n",
    "            else:\n",
    "                print(f\"   Loss:     {abs(improvement):.2f}% ❌\")\n",
    "\n",
    "        print(\"\\n\" + \"=\" * 80)"
   ]
