   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🚨 EMERGENCY STRATEGY 3: OPTUNA HYPERPARAMETER TUNING\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Check if we have the required variables\n",
    "if 'X_train_extreme' not in dir() or 'y_train_extreme' not in dir():\n",
    "    print(\"\\n❌ ERROR: Run Cell 53 (EXTREME XGBoost) first!\")\n",
    "    print(\"   Need: X_train_extreme, y_train_extreme, X_test_extreme, y_test_extreme\")\n",
    "else:\n",
    "    print(\"\\n💡 Let AI find the PERFECT hyperparameters!\")\n",
    "    print(\"   Using Optuna to test 100+ combinations\\n\")\n",
    "\n",
    "    # Install Optuna if not available\n",
    "    try:\n",
    "        import optuna\n",
    "        print(\"✅ Optuna already installed\")\n",
    "    except ImportError:\n",
    "        print(\"⚠️ Installing Optuna...\")\n",
    "        import subprocess\n",
    "        subprocess.check_call(['pip', 'install', '-q', 'optuna'])\n",
    "        import optuna\n",
    "        print(\"✅ Optuna installed!\")\n",
    "\n",
    "    from optuna.samplers import TPESampler\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🚀 Optuna Hyperparameter Search (100 trials, ~20-30 minutes)\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    # Define objective function for Optuna\n",
    "    def objective(trial):\n",
    "        \"\"\"Objective function for Optuna to minimize MAPE\"\"\"\n",
    "\n",
    "        # Suggest hyperparameters\n",
    "        params = {\n",
    "            'n_estimators': trial.suggest_int('n_estimators', 1000, 10000, step=1000),\n",
    "            'max_depth': trial.suggest_int('max_depth', 10, 50),\n",
    "            'learning_rate': trial.suggest_float('learning_rate', 0.001, 0.1, log=True),\n",
    "            'subsample': trial.suggest_float('subsample', 0.6, 1.0),\n",
    "            'colsample_bytree': trial.suggest_float('colsample_bytree', 0.6, 1.0),\n",
    "            'gamma': trial.suggest_float('gamma', 0.001, 1.0, log=True),\n",
    "            'reg_alpha': trial.suggest_float('reg_alpha', 0.001, 1.0, log=True),\n",
    "            'reg_lambda': trial.suggest_float('reg_lambda', 0.001, 1.0, log=True),\n",
    "            'min_child_weight': trial.suggest_int('min_child_weight', 1, 10),\n",
    "            'random_state': 42,\n",
    "            'n_jobs': -1,\n",
    "            'verbosity': 0\n",
    "        }\n",
    "\n",
    "        # Train model\n",
    "        model = xgb.XGBRegressor(**params)\n",
    "        model.fit(X_train_extreme, y_train_extreme, verbose=False)\n",
    "\n",
    "        # Predict and calculate MAPE\n",
    "        y_pred = model.predict(X_test_extreme)\n",
    "        mape = np.mean(np.abs((y_test_extreme - y_pred) / y_test_extreme)) * 100\n",
    "\n",
    "        return mape\n",
    "\n",
    "    # Create Optuna study\n",
    "    print(\"\\n🔍 Starting Optuna optimization...\")\n",
    "    print(\"   This will try 100 different hyperparameter combinations\")\n",
    "    print(\"   Goal: Minimize MAPE\\n\")\n",
    "\n",
    "    import time\n",
    "    start_time = time.time()\n",
    "\n",
    "    # Suppress Optuna's verbose output\n",
    "    optuna.logging.set_verbosity(optuna.logging.WARNING)\n",
    "\n",
    "    study = optuna.create_study(\n",
    "        direction='minimize',\n",
    "        sampler=TPESampler(seed=42)\n",
    "    )\n",
    "\n",
    "    # Run optimization with progress callback\n",
    "    n_trials = 100\n",
    "    best_mapes = []\n",
    "\n",
    "    def callback(study, trial):\n",
    "        \"\"\"Callback to show progress\"\"\"\n",
    "        if trial.number % 10 == 0:\n",
    "            elapsed = (time.time() - start_time) / 60\n",
    "            print(f\"   Trial {trial.number:3}/{n_trials} | Best MAPE so far: {study.best_value:.2f}% | Elapsed: {elapsed:.1f}m\")\n",
    "\n",
    "            # Check if we hit <10%\n",
    "            if study.best_value < 10.0:\n",
    "                print(f\"\\n   🎉🎉🎉 BREAKTHROUGH at trial {trial.number}! MAPE: {study.best_value:.2f}%\")\n",
    "\n",
    "    study.optimize(objective, n_trials=n_trials, callbacks=[callback], show_progress_bar=False)\n",
    "\n",
    "    elapsed_total = (time.time() - start_time) / 60\n",
    "    print(f\"\\n✅ Optimization complete! Total time: {elapsed_total:.1f} minutes\")\n",
    "\n",
    "    # Get best hyperparameters\n",
    "    best_params = study.best_params\n",
    "    best_mape_optuna = study.best_value\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🏆 OPTUNA OPTIMIZATION RESULTS\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    print(f\"\\n🎯 BEST MAPE FOUND: {best_mape_optuna:.2f}%\")\n",
    "    print(f\"   (After testing {n_trials} different hyperparameter combinations)\")\n",
    "\n",
    "    if best_mape_optuna < 10.0:\n",
    "        print(f\"\\n   🎉🎉🎉 *** BREAKTHROUGH!!! ***\")\n",
    "        print(f\"   🏆 OPTUNA FOUND <10% COMBINATION!\")\n",
    "        print(f\"   Gap: -{15.0 - best_mape_optuna:.2f}%\")\n",
    "        print(f\"\\n   ✅✅✅ THIS IS YOUR THESIS MODEL! ✅✅✅\")\n",
    "    elif best_mape_optuna < 11.0:\n",
    "        print(f\"\\n   😊 SO CLOSE! Gap: +{best_mape_optuna - 15.0:.2f}%\")\n",
    "    elif best_mape_optuna < 13.0:\n",
    "        print(f\"\\n   😊 Better! Gap: +{best_mape_optuna - 15.0:.2f}%\")\n",
    "    else:\n",
    "        print(f\"\\n   😞 Gap: +{best_mape_optuna - 15.0:.2f}%\")\n",
    "\n",
    "    print(f\"\\n📊 Optimal Hyperparameters:\")\n",
    "    print(\"-\" * 60)\n",
    "    for param, value in best_params.items():\n",
    "        print(f\"   {param:<20} {value}\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "    # Compare with manual tuning\n",
    "    print(f\"\\n📊 Optuna vs Manual Tuning:\")\n",
    "    print(f\"   Manual XGBoost:     13.38%\")\n",
    "    print(f\"   🏆 Optuna XGBoost:   {best_mape_optuna:.2f}%\")\n",
    "\n",
    "    improvement = 13.38 - best_mape_optuna\n",
    "    if improvement > 0:\n",
    "        print(f\"\\n   ✅ Optuna improved by {improvement:.2f}%!\")\n",
    "    else:\n",
    "        print(f\"\\n   ⚠️ Manual tuning was better by {-improvement:.2f}%\")\n",
    "\n",
    "    # Train final model with best params\n",
    "    print(\"\\n🔧 Training final model with best hyperparameters...\")\n",
    "    model_optuna_best = xgb.XGBRegressor(**best_params, random_state=42, n_jobs=-1, verbosity=0)\n",
    "    model_optuna_best.fit(X_train_extreme, y_train_extreme, verbose=False)\n",
    "    y_pred_optuna = model_optuna_best.predict(X_test_extreme)\n",
    "    print(\"   ✅ Final model trained!\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)"
   ]
  },
