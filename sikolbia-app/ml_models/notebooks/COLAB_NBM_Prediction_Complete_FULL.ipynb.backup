    "\n",
    "print(f\"\\n🟡 TOP 10 Moderate Commodities:\")\n",
    "print(moderate.head(10).to_string())\n",
    "\n",
    "print(f\"\\n🔴 BOTTOM 20 Minor Commodities (SUSPICIOUS!):\")\n",
