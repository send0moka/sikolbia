   ],
   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🎯 STRATEGY 3: SUPER ENSEMBLE - COMBINE ALL BEST MODELS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Combine the best models we have:\n",
    "# 1. NUCLEAR XGBoost (14.04%)\n",
    "# 2. Commodity-Aware (if better)\n",
    "# 3. Polynomial Features (if better)\n",
    "# 4. MEGA Ensemble (16.52%)\n",
    "\n",
    "if 'y_pred_nuclear' not in dir():\n",
    "    print(\"\\n❌ ERROR: Run NUCLEAR XGBoost cell first!\")\n",
    "else:\n",
    "    print(\"\\n📊 Gathering all model predictions...\")\n",
    "\n",
    "    # Collect all predictions\n",
    "    models_super = []\n",
    "\n",
    "    # 1. NUCLEAR XGBoost (required)\n",
    "    if 'mape_nuclear' in dir():\n",
    "        models_super.append({\n",
    "            'name': 'NUCLEAR XGBoost',\n",
    "            'predictions': y_pred_nuclear,\n",
    "            'mape': mape_nuclear\n",
    "        })\n",
    "        print(f\"  ✅ NUCLEAR XGBoost:      {mape_nuclear:.2f}%\")\n",
    "\n",
    "    # 2. Commodity-Aware (optional)\n",
    "    if 'mape_commodity' in dir():\n",
    "        models_super.append({\n",
    "            'name': 'Commodity-Aware XGBoost',\n",
    "            'predictions': y_pred_commodity,\n",
    "            'mape': mape_commodity\n",
    "        })\n",
    "        print(f\"  ✅ Commodity-Aware:      {mape_commodity:.2f}%\")\n",
    "    else:\n",
    "        print(f\"  ⚠️ Commodity-Aware:      Skipped (not trained yet)\")\n",
    "\n",
    "    # 3. Polynomial Features (optional)\n",
    "    if 'mape_poly' in dir():\n",
    "        models_super.append({\n",
    "            'name': 'Polynomial Features XGBoost',\n",
    "            'predictions': y_pred_poly,\n",
    "            'mape': mape_poly\n",
    "        })\n",
    "        print(f\"  ✅ Polynomial Features:  {mape_poly:.2f}%\")\n",
    "    else:\n",
    "        print(f\"  ⚠️ Polynomial Features:  Skipped (not trained yet)\")\n",
    "\n",
    "    # 4. MEGA Ensemble (need to align predictions)\n",
    "    if 'predictions_ensemble_mega' in dir():\n",
    "        # MEGA was trained on ≥50 kkal, NUCLEAR on ≥100 kkal\n",
    "        # We need to map MEGA predictions to NUCLEAR test indices\n",
    "\n",
    "        # Get indices where test >= 100\n",
    "        test_indices_nuclear = np.where(y_test >= 100.0)[0]\n",
    "        # Get indices where test >= 50\n",
    "        test_indices_mega = np.where(y_test >= 50.0)[0]\n",
    "\n",
    "        # Find positions in MEGA that correspond to NUCLEAR indices\n",
    "        mega_to_nuclear_positions = []\n",
    "        for nuclear_idx in test_indices_nuclear:\n",
    "            # Find position of nuclear_idx in test_indices_mega\n",
    "            pos = np.where(test_indices_mega == nuclear_idx)[0]\n",
    "            if len(pos) > 0:\n",
    "                mega_to_nuclear_positions.append(pos[0])\n",
    "\n",
    "        if len(mega_to_nuclear_positions) == len(y_pred_nuclear):\n",
    "            y_pred_mega_aligned = predictions_ensemble_mega[mega_to_nuclear_positions]\n",
    "            mape_mega_aligned = np.mean(np.abs((y_test_nuclear - y_pred_mega_aligned) / y_test_nuclear)) * 100\n",
    "\n",
    "            models_super.append({\n",
    "                'name': 'MEGA Ensemble',\n",
    "                'predictions': y_pred_mega_aligned,\n",
    "                'mape': mape_mega_aligned\n",
    "            })\n",
    "            print(f\"  ✅ MEGA Ensemble:        {mape_mega_aligned:.2f}% (aligned)\")\n",
    "        else:\n",
    "            print(f\"  ⚠️ MEGA Ensemble:        Skipped (alignment issue)\")\n",
    "    else:\n",
    "        print(f\"  ⚠️ MEGA Ensemble:        Skipped (not trained yet)\")\n",
    "\n",
    "    if len(models_super) == 0:\n",
    "        print(\"\\n❌ ERROR: No models available for super ensemble!\")\n",
    "    elif len(models_super) == 1:\n",
    "        print(f\"\\n⚠️ WARNING: Only 1 model available. Run other strategies first for better ensemble!\")\n",
    "        # Still use single model result\n",
    "        mape_super = models_super[0]['mape']\n",
    "        y_pred_super = models_super[0]['predictions']\n",
    "    else:\n",
    "        print(f\"\\n🎯 Total models in super ensemble: {len(models_super)}\")\n",
    "\n",
    "        # Calculate weights (inverse MAPE)\n",
    "        print(\"\\n⚖️ Calculating optimal weights...\")\n",
    "        weights = []\n",
    "        for model in models_super:\n",
    "            # Inverse MAPE weight\n",
    "            inv_mape = 1.0 / (model['mape'] + 1)\n",
    "            weights.append(inv_mape)\n",
    "\n",
    "        # Normalize weights\n",
    "        weights = np.array(weights)\n",
    "        weights = weights / weights.sum()\n",
    "\n",
    "        print(\"\\n📊 Model weights:\")\n",
    "        for i, model in enumerate(models_super):\n",
    "            print(f\"   {model['name']:<35} {weights[i]*100:>5.1f}%  (MAPE: {model['mape']:.2f}%)\")\n",
    "\n",
    "        # Create super ensemble prediction\n",
    "        print(\"\\n🚀 Creating SUPER ENSEMBLE prediction...\")\n",
    "        y_pred_super = np.zeros_like(y_test_nuclear)\n",
    "\n",
    "        for i, model in enumerate(models_super):\n",
    "            y_pred_super += weights[i] * model['predictions']\n",
    "\n",
    "        mape_super = np.mean(np.abs((y_test_nuclear - y_pred_super) / y_test_nuclear)) * 100\n",
    "\n",
    "    if len(models_super) > 0:\n",
    "        print(\"\\n\" + \"=\" * 80)\n",
    "        print(\"🏆 SUPER ENSEMBLE RESULTS - THE ULTIMATE MODEL\")\n",
    "        print(\"=\" * 80)\n",
    "        print(f\"\\n🎯 MAPE: {mape_super:.2f}%\")\n",
    "\n",
    "        if mape_super < 15.0:\n",
    "            print(f\"\\n   🎉🎉🎉 *** SUCCESS!!! ***\")\n",
    "            print(f\"   🏆 ACHIEVED <15% TARGET!\")\n",
    "            print(f\"   Gap: -{15.0 - mape_super:.2f}%\")\n",
    "            print(\"\\n   ✅ THIS IS YOUR THESIS MODEL!\")\n",
    "            print(\"   ✅ Save this model for production!\")\n",
    "        elif mape_super < 12.0:\n",
    "            print(f\"\\n   😊 Very close! Gap: +{mape_super - 15.0:.2f}%\")\n",
    "            print(\"\\n   💡 Consider this model - <12% is still excellent!\")\n",
    "        else:\n",
    "            print(f\"\\n   😞 Gap: +{mape_super - 15.0:.2f}%\")\n",
    "\n",
    "        # Compare with best single model\n",
    "        best_single = min(models_super, key=lambda x: x['mape'])\n",
    "        improvement = best_single['mape'] - mape_super\n",
    "\n",
    "        print(f\"\\n📈 vs Best Single Model ({best_single['name']}):\")\n",
    "        print(f\"   Best Single:    {best_single['mape']:.2f}%\")\n",
    "        print(f\"   Super Ensemble: {mape_super:.2f}%\")\n",
    "        if improvement > 0:\n",
    "            print(f\"   Gain:           {improvement:.2f}% ✅\")\n",
    "        else:\n",
    "            print(f\"   Equivalent:     {abs(improvement):.2f}%\")\n",
    "\n",
    "        print(\"\\n\" + \"=\" * 80)"
   ]
  },
