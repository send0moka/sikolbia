    "}\n",
    "\n",
    "print(\"\\n🔥 Starting GridSearchCV for XGBoost...\")\n",
    "print(f\"  Testing {2*2*2*2*2*2*2} = 128 combinations\")\n",
    "print(\"  This will take 10-15 minutes...\")\n",
    "\n",
    "base_xgb = xgb.XGBRegressor(\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    min_child_weight=1,\n",
    "    gamma=0.1\n",
    ")\n",
    "\n",
    "grid_search = GridSearchCV(\n",
