    "print(\"\\n💡 Strategy: Use asymmetric loss optimized for MAPE\")\n",
    "print(\"   XGBoost default uses MSE, but we want to minimize MAPE\\n\")\n",
    "\n",
    "# Use LightGBM with custom MAPE objective (better than XGBoost for this)\n",
    "try:\n",
    "    import lightgbm as lgb\n",
    "\n",
    "    # Train on ≥200 kkal data (most predictable)\n",
    "    print(\"🎯 Training LightGBM with MAPE objective...\")\n",
    "\n",
    "    model_lgb_extreme = lgb.LGBMRegressor(\n",
    "        n_estimators=5000,\n",
    "        max_depth=30,\n",
    "        learning_rate=0.001,\n",
    "        num_leaves=1000,  # Very complex tree\n",
    "        min_child_samples=1,  # Allow tiny splits\n",
    "        subsample=0.98,\n",
    "        colsample_bytree=0.98,\n",
    "        objective='mape',  # ← KEY: Directly optimize MAPE!\n",
    "        reg_alpha=0.0001,\n",
    "        reg_lambda=0.0001,\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "        verbose=-1\n",
    "    )\n",
    "\n",
    "    print(f\"🚀 Training with MAPE objective... (10-15 minutes)\")\n",
    "    print(f\"   Start: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "    start = datetime.now()\n",
    "\n",
    "    model_lgb_extreme.fit(\n",
    "        X_train_extreme,\n",
    "        y_train_extreme,\n",
    "        eval_set=[(X_val_extreme, y_val_extreme)],\n",
    "        eval_metric='mape',\n",
    "        callbacks=[lgb.early_stopping(stopping_rounds=200), lgb.log_evaluation(0)]\n",
    "    )\n",
    "\n",
    "    duration = (datetime.now() - start).total_seconds()\n",
    "    print(f\"✅ Done in {duration/60:.1f} minutes\")\n",
    "\n",
    "    # Predict\n",
    "    y_pred_lgb_extreme = model_lgb_extreme.predict(X_test_extreme)\n",
    "    mape_lgb_extreme = np.mean(np.abs((y_test_extreme - y_pred_lgb_extreme) / y_test_extreme)) * 100\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🔥 LIGHTGBM MAPE OBJECTIVE RESULTS\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"\\n🎯 MAPE: {mape_lgb_extreme:.2f}%\")\n",
    "\n",
    "    if mape_lgb_extreme < 15.0:\n",
    "        print(f\"\\n   🔥🔥🔥 *** SUCCESS WITH MAPE OBJECTIVE!!! ***\")\n",
    "        print(f\"   🏆 ACHIEVED <15% TARGET!\")\n",
    "        print(f\"   Gap: -{15.0 - mape_lgb_extreme:.2f}%\")\n",
    "    elif mape_lgb_extreme < 12.0:\n",
    "        print(f\"\\n   😊 Very close! Gap: +{mape_lgb_extreme - 15.0:.2f}%\")\n",
    "    else:\n",
    "        print(f\"\\n   😞 Gap: +{mape_lgb_extreme - 15.0:.2f}%\")\n",
    "\n",
    "    # Compare\n",
    "    if 'mape_extreme' in dir():\n",
    "        improvement = mape_extreme - mape_lgb_extreme\n",
    "        print(f\"\\n📈 vs XGBoost EXTREME:\")\n",
    "        print(f\"   XGBoost (MSE loss):  {mape_extreme:.2f}%\")\n",
    "        print(f\"   LightGBM (MAPE loss): {mape_lgb_extreme:.2f}%\")\n",
    "        if improvement > 0:\n",
    "            print(f\"   Gain from MAPE obj:   {improvement:.2f}% ✅\")\n",
    "        else:\n",
    "            print(f\"   Change:               {improvement:.2f}%\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "\n",
    "except ImportError:\n",
    "    print(\"⚠️ LightGBM not installed. Installing...\")\n",
    "    import subprocess\n",
    "    subprocess.check_call(['pip', 'install', 'lightgbm'])\n",
    "    print(\"✅ Installed! Please re-run this cell.\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Error: {e}\")\n",
    "    print(\"Skipping LightGBM strategy...\")"
   ]
