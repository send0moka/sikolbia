    "print(\"=\" * 80)\n",
    "print(\"🔥🔥🔥 MEGA XGBOOST - 2000 TREES + EXTREME TUNING 🔥🔥🔥\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "import xgboost as xgb\n",
    "from datetime import datetime\n",
    "\n",
    "if 'X_train_mega' not in dir():\n",
    "    print(\"\\n❌ ERROR: Run previous cell first (MEGA Filter)!\")\n",
    "else:\n",
    "    print(\"\\n📋 MEGA XGBoost Configuration:\")\n",
    "    print(\"  • n_estimators: 2000 (EXTREME!)\")\n",
    "    print(\"  • max_depth: 20 (very deep)\")\n",
    "    print(\"  • learning_rate: 0.005 (very slow, more accurate)\")\n",
    "    print(\"  • min_child_weight: 0.5 (allow finer splits)\")\n",
    "    print(\"  • subsample: 0.9\")\n",
    "    print(\"  • colsample_bytree: 0.9\")\n",
    "    print(\"  • gamma: 0.01 (minimal pruning)\")\n",
    "    print(\"  • early_stopping_rounds: 100\")\n",
    "    print(f\"  • Training on MEGA filtered data ({len(y_train_mega):,} samples)\")\n",
    "\n",
    "    model_xgb_mega = xgb.XGBRegressor(\n",
    "        n_estimators=2000,\n",
    "        max_depth=20,\n",
    "        learning_rate=0.005,\n",
    "        min_child_weight=0.5,\n",
    "        subsample=0.9,\n",
    "        colsample_bytree=0.9,\n",
    "        gamma=0.01,\n",
    "        random_state=42,\n",
    "        n_jobs=-1,\n",
    "        verbosity=0  # Silent to avoid too much output\n",
    "    )\n",
    "\n",
    "    print(\"\\n🚀 Training MEGA XGBoost... (20-30 minutes)\")\n",
    "    print(f\"   Start: {datetime.now().strftime('%H:%M:%S')}\")\n",
    "    start_time = datetime.now()\n",
    "\n",
    "    # Train with early stopping\n",
    "    model_xgb_mega.fit(\n",
    "        X_train_mega,\n",
    "        y_train_mega,\n",
    "        eval_set=[(X_val_mega, y_val_mega)],\n",
    "        verbose=False\n",
    "    )\n",
    "\n",
    "    end_time = datetime.now()\n",
    "    duration = (end_time - start_time).total_seconds()\n",
    "    print(f\"✅ Completed in {duration/60:.1f} minutes\")\n",
    "    print(f\"   End: {end_time.strftime('%H:%M:%S')}\")\n",
    "\n",
    "    # Check if early stopping was used (best_iteration only available if early stopping triggered)\n",
    "    if hasattr(model_xgb_mega, 'best_iteration') and model_xgb_mega.best_iteration > 0:\n",
    "        print(f\"   Best iteration: {model_xgb_mega.best_iteration}\")\n",
    "    else:\n",
    "        print(f\"   Used all {model_xgb_mega.n_estimators} estimators (no early stopping)\")\n",
    "\n",
    "    # Predict\n",
    "    y_test_pred_xgb_mega = model_xgb_mega.predict(X_test_mega)\n",
    "\n",
    "    # Calculate MAPE\n",
    "    mape_xgb_mega = np.mean(np.abs((y_test_mega - y_test_pred_xgb_mega) / y_test_mega)) * 100\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"📊 MEGA XGBOOST RESULTS\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"\\n🎯 MAPE: {mape_xgb_mega:.2f}%\")\n",
    "\n",
    "    if mape_xgb_mega < 15.0:\n",
    "        print(f\"\\n   🎉🎉🎉 *** SUCCESS!!! ***\")\n",
    "        print(f\"   🏆 ACHIEVED <15% TARGET!\")\n",
    "        print(f\"   Gap: -{15.0 - mape_xgb_mega:.2f}%\")\n",
    "    elif mape_xgb_mega < 12.0:\n",
    "        print(f\"\\n   😊 Very close! Gap: +{mape_xgb_mega - 15.0:.2f}%\")\n",
    "    elif mape_xgb_mega < 15.0:\n",
    "        print(f\"\\n   😐 Good, but gap: +{mape_xgb_mega - 15.0:.2f}%\")\n",
    "    else:\n",
    "        print(f\"\\n   😞 Gap: +{mape_xgb_mega - 15.0:.2f}%\")\n",
    "\n",
    "    # Compare with previous best\n",
    "    if 'mape_lstm_enhanced' in dir():\n",
    "        improvement = mape_lstm_enhanced - mape_xgb_mega\n",
    "        print(f\"\\n📈 vs LSTM Enhanced ULTRA:\")\n",
    "        print(f\"   Previous: {mape_lstm_enhanced:.2f}%\")\n",
    "        print(f\"   MEGA:     {mape_xgb_mega:.2f}%\")\n",
    "        if improvement > 0:\n",
    "            print(f\"   Gain:     {improvement:.2f}% ({improvement/mape_lstm_enhanced*100:.1f}% better) ✅\")\n",
    "        else:\n",
    "            print(f\"   Loss:     {abs(improvement):.2f}% ❌\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)"
   ]
