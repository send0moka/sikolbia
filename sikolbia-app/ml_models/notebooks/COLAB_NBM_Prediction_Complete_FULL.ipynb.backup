    "print(\"=\" * 80)\n",
    "print(\"🏆 FINAL ULTRA AGGRESSIVE RESULTS COMPARISON\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Build results dictionary - check if variables exist first\n",
    "results_ultra = {}\n",
    "\n",
    "# Original models (should always exist)\n",
    "try:\n",
    "    results_ultra['XGBoost (Original)'] = xgb_test_metrics['mape']\n",
    "    results_ultra['Huber (Original)'] = huber_test_metrics['mape']\n",
    "    results_ultra['LSTM (Original)'] = lstm_test_metrics['mape']\n",
    "    results_ultra['Ensemble (Original 3-way)'] = ensemble_test_metrics['mape']\n",
    "except NameError:\n",
    "    print(\"⚠️ Original models not found. Please run cells 19-33 first.\")\n",
    "    print(\"   Current cell shows comparison only if all previous cells are executed.\\n\")\n",
    "\n",
    "# ULTRA models (may not exist yet)\n",
    "if 'mape_xgb_ultra' in dir():\n",
    "    results_ultra['XGBoost (ULTRA - Filtered)'] = mape_xgb_ultra\n",
    "\n",
    "if 'mape_huber_ultra' in dir():\n",
    "    results_ultra['Huber (ULTRA - Filtered)'] = mape_huber_ultra\n",
    "\n",
    "if 'mape_stacking' in dir():\n",
    "    results_ultra['STACKING ENSEMBLE (Filtered)'] = mape_stacking\n",
    "\n",
    "if 'mape_lstm_enhanced' in dir():\n",
    "    results_ultra['LSTM ENHANCED ENSEMBLE (ULTRA)'] = mape_lstm_enhanced\n",
    "\n",
    "# Show results if we have any\n",
    "if len(results_ultra) == 0:\n",
    "    print(\"❌ No results to display.\")\n",
    "    print(\"\\n📋 Please run cells in order:\")\n",
    "    print(\"   1. Cell 19-20: XGBoost Original\")\n",
    "    print(\"   2. Cell 27: LSTM Original\")\n",
    "    print(\"   3. Cell 30: Huber Original\")\n",
    "    print(\"   4. Cell 33: Ensemble Original\")\n",
    "    print(\"   5. Cell 35: XGBoost ULTRA (Filter + Train)\")\n",
    "    print(\"   6. Cell 36: Huber ULTRA\")\n",
    "    print(\"   7. Cell 37: Stacking Ensemble\")\n",
    "    print(\"   8. Cell 38: LSTM Enhanced ULTRA\")\n",
    "    print(\"   9. Cell 39: This comparison cell\")\n",
    "else:\n",
    "    print(f\"\\n📊 Available Models MAPE Comparison ({len(results_ultra)} models):\\n\")\n",
    "\n",
    "    for model_name, mape in sorted(results_ultra.items(), key=lambda x: x[1]):\n",
    "        status = \"\"\n",
    "        if mape < 15:\n",
    "            status = \"🎉 TARGET ACHIEVED!\"\n",
    "        elif mape < 12:\n",
    "            status = \"✅✅ VERY CLOSE\"\n",
    "        elif mape < 15:\n",
    "            status = \"✅ GOOD\"\n",
    "        elif mape < 20:\n",
    "            status = \"😐 OK\"\n",
    "        else:\n",
    "            status = \"⚠️ NEEDS IMPROVEMENT\"\n",
    "\n",
    "        print(f\"{model_name:40s} {mape:6.2f}%  {status}\")\n",
    "\n",
    "    # Find best model\n",
    "    best_model_name = min(results_ultra.items(), key=lambda x: x[1])[0]\n",
    "    best_mape = min(results_ultra.values())\n",
    "\n",
    "    print(f\"\\n{'='*80}\")\n",
    "    print(f\"🏆 BEST MODEL: {best_model_name}\")\n",
    "    print(f\"   MAPE: {best_mape:.2f}%\")\n",
    "\n",
    "    if best_mape < 15:\n",
    "        print(f\"   🎉🎉🎉 TARGET ACHIEVED! Below by {15 - best_mape:.2f}%\")\n",
    "    else:\n",
    "        print(f\"   Gap: +{best_mape - 15:.2f}% from target\")\n",
    "    print(f\"{'='*80}\")\n",
    "\n",
    "    print(f\"\\n💡 Recommendation:\")\n",
    "    if best_mape < 15:\n",
    "        print(f\"   Use {best_model_name} for production deployment!\")\n",
    "    elif best_mape < 12:\n",
    "        print(f\"   {best_model_name} is very close to target (<2% gap)\")\n",
    "        print(f\"   This is EXCELLENT for NBM multi-commodity prediction!\")\n",
    "        print(f\"   Consider accepting this result for thesis.\")\n",
    "    else:\n",
    "        print(f\"   Best achieved: {best_mape:.2f}%\")\n",
    "        print(f\"   Continue running ULTRA cells (35-38) for better results.\")\n",
    "\n",
    "    # Show which cells still need to be run\n",
    "    missing_ultra = []\n",
    "    if 'mape_xgb_ultra' not in dir():\n",
    "        missing_ultra.append(\"Cell 35 (XGBoost ULTRA)\")\n",
    "    if 'mape_huber_ultra' not in dir():\n",
    "        missing_ultra.append(\"Cell 36 (Huber ULTRA)\")\n",
    "    if 'mape_stacking' not in dir():\n",
    "        missing_ultra.append(\"Cell 37 (Stacking)\")\n",
    "    if 'mape_lstm_enhanced' not in dir():\n",
    "        missing_ultra.append(\"Cell 38 (LSTM Enhanced ULTRA)\")\n",
    "\n",
    "    if len(missing_ultra) > 0:\n",
    "        print(f\"\\n⚠️ Not yet run ({len(missing_ultra)} strategies):\")\n",
    "        for cell in missing_ultra:\n",
    "            print(f\"   • {cell}\")\n",
    "        print(f\"\\n   Run these cells for potentially better results!\")"
   ]
