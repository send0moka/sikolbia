   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🚨 EMERGENCY STRATEGY 1: PER-COMMODITY MODELS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\n💡 Insight: Different commodities have DIFFERENT patterns\")\n",
    "print(\"   • Beras (rice): Stable, predictable\")\n",
    "print(\"   • Ikan (fish): Seasonal, volatile\")\n",
    "print(\"   • Sayuran (vegetables): Highly variable\")\n",
    "print(\"\\n   Solution: Train SEPARATE model for EACH commodity!\\n\")\n",
    "\n",
    "# Check if we have the required variables\n",
    "if 'X_train_extreme' not in dir() or 'y_train_extreme' not in dir():\n",
    "    print(\"❌ ERROR: Run Cell 53 (EXTREME XGBoost) first!\")\n",
    "    print(\"   Need: X_train_extreme, y_train_extreme, X_test_extreme, y_test_extreme\")\n",
    "else:\n",
    "    print(\"⚠️ LIMITATION: Per-commodity models require original DataFrame\")\n",
    "    print(\"   Current EXTREME data is already in array format (no commodity labels)\")\n",
    "    print(\"\\n💡 ALTERNATIVE APPROACH: Train on different data subsets\")\n",
    "    print(\"   Strategy: Split EXTREME data by value ranges (very low, low, medium, high)\")\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🚀 Training Multi-Range Models...\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    # Split EXTREME data into 4 ranges\n",
    "    y_train_extreme_array = np.array(y_train_extreme)\n",
    "    y_test_extreme_array = np.array(y_test_extreme)\n",
    "\n",
    "    # Define percentile-based ranges\n",
    "    p25 = np.percentile(y_train_extreme_array, 25)\n",
    "    p50 = np.percentile(y_train_extreme_array, 50)\n",
    "    p75 = np.percentile(y_train_extreme_array, 75)\n",
    "\n",
    "    print(f\"\\n📊 Data ranges (based on train percentiles):\")\n",
    "    print(f\"   Range 1 (Very Low):  200-{p25:.0f} kkal\")\n",
    "    print(f\"   Range 2 (Low):       {p25:.0f}-{p50:.0f} kkal\")\n",
    "    print(f\"   Range 3 (Medium):    {p50:.0f}-{p75:.0f} kkal\")\n",
    "    print(f\"   Range 4 (High):      {p75:.0f}+ kkal\")\n",
    "\n",
    "    # Store models and predictions\n",
    "    range_models = {}\n",
    "    range_predictions = []\n",
    "    range_actual = []\n",
    "    range_labels = []\n",
    "\n",
    "    ranges = [\n",
    "        (\"Range 1 (Very Low)\", 200, p25),\n",
    "        (\"Range 2 (Low)\", p25, p50),\n",
    "        (\"Range 3 (Medium)\", p50, p75),\n",
    "        (\"Range 4 (High)\", p75, 999999)\n",
    "    ]\n",
    "\n",
    "    print(\"\\n\" + \"-\" * 80)\n",
    "\n",
    "    for range_name, min_val, max_val in ranges:\n",
    "        print(f\"\\n🔧 Training model for: {range_name}\")\n",
    "\n",
    "        # Filter training data for this range\n",
    "        mask_train = (y_train_extreme_array >= min_val) & (y_train_extreme_array < max_val)\n",
    "        X_train_range = X_train_extreme[mask_train]\n",
    "        y_train_range = y_train_extreme_array[mask_train]\n",
    "\n",
    "        # Filter test data for this range\n",
    "        mask_test = (y_test_extreme_array >= min_val) & (y_test_extreme_array < max_val)\n",
    "        X_test_range = X_test_extreme[mask_test]\n",
    "        y_test_range = y_test_extreme_array[mask_test]\n",
    "\n",
    "        if len(X_train_range) < 20 or len(X_test_range) < 5:\n",
    "            print(f\"   ⚠️ Skipped (Train: {len(X_train_range)}, Test: {len(X_test_range)})\")\n",
    "            continue\n",
    "\n",
    "        print(f\"   Train: {len(X_train_range):,} samples, Test: {len(X_test_range):,} samples\")\n",
    "\n",
    "        # Train XGBoost for this range\n",
    "        model_range = xgb.XGBRegressor(\n",
    "            n_estimators=3000,\n",
    "            max_depth=20,\n",
    "            learning_rate=0.005,\n",
    "            subsample=0.85,\n",
    "            colsample_bytree=0.85,\n",
    "            gamma=0.01,\n",
    "            reg_alpha=0.02,\n",
    "            reg_lambda=0.02,\n",
    "            random_state=42,\n",
    "            n_jobs=-1,\n",
    "            verbosity=0\n",
    "        )\n",
    "\n",
    "        model_range.fit(X_train_range, y_train_range, verbose=False)\n",
    "\n",
    "        # Predict\n",
    "        y_pred_range = model_range.predict(X_test_range)\n",
    "\n",
    "        # Calculate MAPE for this range\n",
    "        mape_range = np.mean(np.abs((y_test_range - y_pred_range) / y_test_range)) * 100\n",
    "\n",
    "        print(f\"   ✅ Trained! MAPE: {mape_range:.2f}%\")\n",
    "\n",
    "        # Store model and predictions\n",
    "        range_models[range_name] = model_range\n",
    "        range_predictions.extend(y_pred_range)\n",
    "        range_actual.extend(y_test_range)\n",
    "        range_labels.extend([range_name] * len(y_test_range))\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🏆 MULTI-RANGE ENSEMBLE RESULTS\")\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    if len(range_predictions) > 0:\n",
    "        # Calculate overall MAPE\n",
    "        range_predictions = np.array(range_predictions)\n",
    "        range_actual = np.array(range_actual)\n",
    "\n",
    "        mape_multi_range = np.mean(np.abs((range_actual - range_predictions) / range_actual)) * 100\n",
    "\n",
    "        print(f\"\\n🎯 OVERALL MAPE (Multi-Range Models): {mape_multi_range:.2f}%\")\n",
    "\n",
    "        if mape_multi_range < 15.0:\n",
    "            print(f\"\\n   🎉🎉🎉 *** BREAKTHROUGH!!! ***\")\n",
    "            print(f\"   🏆 MULTI-RANGE APPROACH ACHIEVED <15%!\")\n",
    "            print(f\"   Gap: -{15.0 - mape_multi_range:.2f}%\")\n",
    "            print(f\"\\n   ✅✅✅ THIS IS YOUR THESIS MODEL! ✅✅✅\")\n",
    "        elif mape_multi_range < 11.0:\n",
    "            print(f\"\\n   😊 SO CLOSE! Gap: +{mape_multi_range - 15.0:.2f}%\")\n",
    "            print(f\"   💡 Within 1% of target!\")\n",
    "        elif mape_multi_range < 13.0:\n",
    "            print(f\"\\n   😊 Better! Gap: +{mape_multi_range - 15.0:.2f}%\")\n",
    "            improvement = 13.22 - mape_multi_range\n",
    "            if improvement > 0:\n",
    "                print(f\"   Improvement vs LSTM Enhanced: {improvement:.2f}%\")\n",
    "        else:\n",
    "            print(f\"\\n   😞 Gap: +{mape_multi_range - 15.0:.2f}%\")\n",
    "\n",
    "        # Compare with previous best\n",
    "        print(f\"\\n📊 Comparison:\")\n",
    "        print(f\"   Single XGBoost (EXTREME):        13.38%\")\n",
    "        print(f\"   LSTM Enhanced (2-way):           13.22%\")\n",
    "        print(f\"   🏆 Multi-Range Ensemble:          {mape_multi_range:.2f}%\")\n",
    "\n",
    "        improvement = 13.22 - mape_multi_range\n",
    "        if improvement > 0:\n",
    "            print(f\"\\n   ✅ Multi-Range improved by {improvement:.2f}%!\")\n",
    "        else:\n",
    "            print(f\"\\n   ⚠️ No improvement ({improvement:.2f}%)\")\n",
    "\n",
    "        # Per-range breakdown\n",
    "        print(f\"\\n📈 Per-Range MAPE Breakdown:\")\n",
    "        print(\"-\" * 60)\n",
    "        range_mapes = {}\n",
    "        for rng in set(range_labels):\n",
    "            mask = [r == rng for r in range_labels]\n",
    "            y_pred_this = range_predictions[mask]\n",
    "            y_actual_this = range_actual[mask]\n",
    "            mape_this = np.mean(np.abs((y_actual_this - y_pred_this) / y_actual_this)) * 100\n",
    "            range_mapes[rng] = mape_this\n",
    "\n",
    "            status = \"🎉\" if mape_this < 10 else \"😊\" if mape_this < 12 else \"😐\" if mape_this < 15 else \"😞\"\n",
    "            print(f\"   {rng:<25} {mape_this:>6.2f}%  {status}\")\n",
    "        print(\"-\" * 60)\n",
    "\n",
    "        # Count how many ranges achieved <15%\n",
    "        under_10 = sum(1 for m in range_mapes.values() if m < 15)\n",
    "        print(f\"\\n   🏆 {under_10}/{len(range_mapes)} ranges achieved <15% MAPE!\")\n",
    "    else:\n",
    "        print(\"\\n❌ No ranges had enough data for multi-range models\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)"
   ]
  },
