    "    print(\"  • alpha: 0.0000001 (minimal regularization)\")\n",
    "    print(\"  • Training on FILTERED data only\")\n",
    "\n",
    "    model_huber_ultra = HuberRegressor(\n",
    "        epsilon=1.15,\n",
    "        max_iter=10000,\n",
    "        alpha=0.0000001,\n",
    "        fit_intercept=True\n",
    "    )\n",
    "\n",
    "    print(\"\\n🚀 Training Huber ULTRA... (This will take 5-10 minutes)\")\n",
    "    print(f\"   Start time: {datetime.now().strftime('%H:%M:%S')}\")\n",
