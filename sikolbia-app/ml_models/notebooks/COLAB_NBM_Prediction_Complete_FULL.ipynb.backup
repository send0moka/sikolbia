   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🏆 ABSOLUTE FINAL VERDICT - LSTM ENHANCED ENSEMBLE\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\n📊 ALL LSTM ENHANCED ENSEMBLE RESULTS:\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "all_ensemble_results = []\n",
    "\n",
    "# Collect all ensemble results\n",
    "if 'mape_lstm_enhanced_extreme' in dir():\n",
    "    all_ensemble_results.append(('LSTM Enhanced (2-way: XGBoost+LSTM)', mape_lstm_enhanced_extreme))\n",
    "\n",
    "if 'mape_ultimate' in dir():\n",
    "    all_ensemble_results.append(('🏆 LSTM Enhanced (3-way: XGBoost+CatBoost+LSTM)', mape_ultimate))\n",
    "\n",
    "if 'mape_super' in dir():\n",
    "    all_ensemble_results.append(('Super Ensemble (Advanced strategies)', mape_super))\n",
    "\n",
    "if 'mape_ensemble_mega' in dir():\n",
    "    all_ensemble_results.append(('LSTM Enhanced MEGA (≥50 kkal)', mape_ensemble_mega))\n",
    "\n",
    "if 'mape_lstm_enhanced' in dir():\n",
    "    all_ensemble_results.append(('LSTM Enhanced ULTRA (≥10 kkal)', mape_lstm_enhanced))\n",
    "\n",
    "# Sort by MAPE\n",
    "all_ensemble_results_sorted = sorted(all_ensemble_results, key=lambda x: x[1])\n",
    "\n",
    "if len(all_ensemble_results_sorted) > 0:\n",
    "    print(f\"\\n{'Rank':<6} {'LSTM Enhanced Ensemble Variant':<55} {'MAPE':>10} {'vs Target':>10}\")\n",
    "    print(\"-\" * 85)\n",
    "\n",
    "    for rank, (name, mape) in enumerate(all_ensemble_results_sorted, 1):\n",
    "        gap = mape - 15.0\n",
    "        gap_str = f\"+{gap:.2f}%\" if gap > 0 else f\"{gap:.2f}%\"\n",
    "\n",
    "        if mape < 15.0:\n",
    "            indicator = \"🎉 ✅\"\n",
    "        elif mape < 11.0:\n",
    "            indicator = \"😊 ⭐\"\n",
    "        elif mape < 12.0:\n",
    "            indicator = \"😊\"\n",
    "        else:\n",
    "            indicator = \"😐\"\n",
    "\n",
    "        print(f\"{rank:<6} {name:<55} {mape:>9.2f}% {gap_str:>9}  {indicator}\")\n",
    "\n",
    "    print(\"-\" * 85)\n",
    "\n",
    "    best_name, best_mape = all_ensemble_results_sorted[0]\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"🏆 BEST LSTM ENHANCED ENSEMBLE\")\n",
    "    print(\"=\" * 80)\n",
    "    print(f\"\\nModel: {best_name}\")\n",
    "    print(f\"MAPE: {best_mape:.2f}%\")\n",
