    "        else:\n",
    "            diff = mape_lstm_extreme - mape_extreme\n",
    "            print(f\"   XGBoost better by: {diff:.2f}%\")\n",
    "            print(f\"   💡 But ensemble of both might be <10%!\")\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)"
   ]
