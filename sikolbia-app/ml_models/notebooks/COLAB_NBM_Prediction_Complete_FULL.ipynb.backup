   "source": [
    "print(\"=\" * 80)\n",
    "print(\"🔥🔥🔥 MEGA STRATEGY: FOCUS ONLY ON MAJOR COMMODITIES 🔥🔥🔥\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "# Strategy: Train ONLY on major commodities (>=50 kkal)\n",
    "# This removes ~90% of noise and focuses on policy-relevant items\n",
    "\n",
    "# Check threshold distribution first\n",
    "thresholds = [10, 20, 50, 100, 200]\n",
    "print(\"\\n📊 Data Distribution by Threshold:\")\n",
    "print(\"=\" * 80)\n",
    "for thresh in thresholds:\n",
    "    train_count = np.sum(y_train >= thresh)\n",
    "    test_count = np.sum(y_test >= thresh)\n",
    "    train_pct = train_count / len(y_train) * 100\n",
    "    test_pct = test_count / len(y_test) * 100\n",
    "    print(f\"  ≥{thresh:3d} kkal: Train {train_count:6,} ({train_pct:5.1f}%)  |  Test {test_count:5,} ({test_pct:5.1f}%)\")\n",
    "\n",
    "# Use threshold = 50 kkal (focus on truly major commodities)\n",
    "MEGA_THRESHOLD = 50.0\n",
    "\n",
    "print(f\"\\n🎯 Using threshold: {MEGA_THRESHOLD} kkal\")\n",
    "print(\"   (Focus on major commodities only)\")\n",
    "\n",
    "# Filter with mega threshold\n",
    "mask_train_mega = y_train >= MEGA_THRESHOLD\n",
    "X_train_mega = X_train_scaled[mask_train_mega]\n",
    "y_train_mega = y_train[mask_train_mega]\n",
    "\n",
    "mask_val_mega = y_val >= MEGA_THRESHOLD\n",
    "X_val_mega = X_val_scaled[mask_val_mega]\n",
    "y_val_mega = y_val[mask_val_mega]\n",
    "\n",
    "mask_test_mega = y_test >= MEGA_THRESHOLD\n",
    "X_test_mega = X_test_scaled[mask_test_mega]\n",
    "y_test_mega = y_test[mask_test_mega]\n",
    "\n",
    "print(f\"\\n📊 MEGA Filtered Dataset:\")\n",
